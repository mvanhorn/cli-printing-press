// Detail pages are commonly addressed as /<prefix>/<id>/<slug>.html. Extraction
// must surface BOTH parts: returning only the first segment (and calling it a
// slug) hands callers an opaque id under the wrong name and drops the slug
// entirely, so discovery output cannot be fed back into a command that takes
// --id and --slug.
func TestHTMLLinkPathParts(t *testing.T) {
	prefixes := []string{"/tracklist", "/track"}

	tests := []struct {
		name     string
		path     string
		prefixes []string
		wantID   string
		wantSlug string
	}{
		{
			name:     "id and slug split on a .html detail page",
			path:     "/tracklist/1k1l3xtt/some-dj-radio-show-2026-08-12.html",
			prefixes: prefixes,
			wantID:   "1k1l3xtt",
			wantSlug: "some-dj-radio-show-2026-08-12",
		},
		{
			name:     "trailing directory-index segment is dropped",
			path:     "/track/4zf271tp/some-artist-some-title/index.html",
			prefixes: prefixes,
			wantID:   "4zf271tp",
			wantSlug: "some-artist-some-title",
		},
		{
			name:     "single segment is a slug with no id",
			path:     "/genre/afro-house",
			prefixes: []string{"/genre"},
			wantID:   "",
			wantSlug: "afro-house",
		},
		{
			name:     "single segment with page extension",
			path:     "/specials/most_liked.html",
			prefixes: []string{"/specials"},
			wantID:   "",
			wantSlug: "most_liked",
		},
		{
			// The regression case. "/tracklist" is tried first and must NOT
			// swallow "/track/...": the old guard compared the trimmed
			// remainder against the original path, which can never match for
			// an absolute path because Trim also strips the leading slash, so
			// any prefix was accepted and this yielded id="track", slug="index".
			name:     "earlier similar prefix does not swallow a later one",
			path:     "/track/4zf271tp/some-artist-some-title/index.html",
			prefixes: []string{"/tracklist", "/track"},
			wantID:   "4zf271tp",
			wantSlug: "some-artist-some-title",
		},
		{
			// When no configured prefix matches, the whole path is the
			// fallback, so the leading segment becomes the id. Asserted so the
			// fallback stays deliberate rather than drifting silently.
			name:     "no matching prefix falls back to the full path",
			path:     "/track/4zf271tp/some-artist-some-title/index.html",
			prefixes: []string{"/tracklist"},
			wantID:   "track",
			wantSlug: "some-artist-some-title",
		},
		{
			name:     "prefix supplied without a leading slash still matches",
			path:     "/tracklist/abc123/a-slug.html",
			prefixes: []string{"tracklist"},
			wantID:   "abc123",
			wantSlug: "a-slug",
		},
		{
			name:     "path equal to the prefix yields nothing",
			path:     "/tracklist",
			prefixes: prefixes,
			wantID:   "",
			wantSlug: "tracklist",
		},
		{
			name:     "empty path yields nothing",
			path:     "/",
			prefixes: prefixes,
			wantID:   "",
			wantSlug: "",
		},
	}

	for _, tc := range tests {
		gotID, gotSlug := htmlLinkPathParts(tc.path, tc.prefixes)
		if gotID != tc.wantID || gotSlug != tc.wantSlug {
			t.Errorf("%s: htmlLinkPathParts(%q, %v) = (%q, %q), want (%q, %q)",
				tc.name, tc.path, tc.prefixes, gotID, gotSlug, tc.wantID, tc.wantSlug)
		}
	}
}

func TestTrimHTMLPageExt(t *testing.T) {
	tests := []struct {
		in   string
		want string
	}{
		{in: "a-slug.html", want: "a-slug"},
		{in: "a-slug.htm", want: "a-slug"},
		{in: "a-slug.php", want: "a-slug"},
		{in: "a-slug.aspx", want: "a-slug"},
		{in: "A-SLUG.HTML", want: "A-SLUG"},
		{in: "a-slug", want: "a-slug"},
		{in: "a.slug.with.dots", want: "a.slug.with.dots"},
		{in: "", want: ""},
	}
	for _, tc := range tests {
		if got := trimHTMLPageExt(tc.in); got != tc.want {
			t.Errorf("trimHTMLPageExt(%q) = %q, want %q", tc.in, got, tc.want)
		}
	}
}

// An absent href/src must stay absent. url.Parse("") yields an empty reference,
// and resolving that against the base returns the base itself — which showed up
// as every extracted link reporting the bare site root as its image, and as a
// page with no <link rel=canonical> silently adopting the base URL.
func TestNormalizeHTMLURLEmptyInput(t *testing.T) {
	const base = "https://example.com/some/page.html"

	tests := []struct {
		name string
		raw  string
		want string
	}{
		{name: "empty string", raw: "", want: ""},
		{name: "whitespace only", raw: "   ", want: ""},
		{name: "tab and newline only", raw: "\t\n", want: ""},
	}
	for _, tc := range tests {
		if got := normalizeHTMLURL(tc.raw, base); got != tc.want {
			t.Errorf("%s: normalizeHTMLURL(%q, base) = %q, want %q", tc.name, tc.raw, got, tc.want)
		}
	}
}

func TestNormalizeHTMLURLResolves(t *testing.T) {
	const base = "https://example.com/some/page.html"

	tests := []struct {
		name string
		raw  string
		want string
	}{
		{
			name: "absolute url passes through",
			raw:  "https://cdn.example.net/img.png",
			want: "https://cdn.example.net/img.png",
		},
		{
			name: "root-relative resolves against base host",
			raw:  "/assets/img.png",
			want: "https://example.com/assets/img.png",
		},
		{
			name: "surrounding whitespace is trimmed before resolving",
			raw:  "  /assets/img.png  ",
			want: "https://example.com/assets/img.png",
		},
	}
	for _, tc := range tests {
		if got := normalizeHTMLURL(tc.raw, base); got != tc.want {
			t.Errorf("%s: normalizeHTMLURL(%q, base) = %q, want %q", tc.name, tc.raw, got, tc.want)
		}
	}
}
