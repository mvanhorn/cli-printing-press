// RateLimitError signals the {{humanName .Name}} OAuth token endpoint returned 429
// Too Many Requests. RetryAfter captures the server-advertised retry
// window (parsed from the Retry-After header, in seconds) when present;
// zero means the header was absent or unparseable.
type RateLimitError struct {
	RetryAfter time.Duration
	Body       string
}

func (e *RateLimitError) Error() string {
	if e.RetryAfter > 0 {
		return fmt.Sprintf("{{humanName .Name}} token endpoint rate-limited; retry after %s", e.RetryAfter)
	}
	return "{{humanName .Name}} token endpoint rate-limited"
}

// parseRetryAfter reads the Retry-After header, supporting both the
// "delta-seconds" and HTTP-date forms per RFC 7231 §7.1.3.
func parseRetryAfter(h string) time.Duration {
	h = strings.TrimSpace(h)
	if h == "" {
		return 0
	}
	if n, err := strconv.Atoi(h); err == nil && n > 0 {
		return time.Duration(n) * time.Second
	}
	if t, err := http.ParseTime(h); err == nil {
		if d := time.Until(t); d > 0 {
			return d
		}
	}
	return 0
}

// Process-level mutex guarding refresh races. A second goroutine that
// enters RefreshIfNeeded while a first one is mid-flight will block on
// this until the first goroutine has persisted the new tokens AND
// released the lock, then re-read the file and either short-circuit
// (already fresh) or refresh again. Without this, two concurrent
// invocations could send the same refresh_token twice and lose the
// rotation that arrived first.
var refreshMu sync.Mutex

// refreshLimiter paces calls to the OAuth token endpoint. Token refresh
// is a low-volume operation (a healthy client refreshes once per hour
// per access token), so a 1 req/sec floor with adaptive ramp keeps
// rotate-test loops and recovery storms (e.g. several CLI processes
// rebooting at once) from hammering the endpoint past the provider's tolerance.
// On 429 the limiter halves itself; the typed RateLimitError below carries
// the server's Retry-After hint to callers.
var refreshLimiter = cliutil.NewAdaptiveLimiter(1)

// DefaultTokenURL is the {{humanName .Name}} OAuth2 endpoint. Override via env
// {{envPrefix .Name}}_TOKEN_URL when pointing at a mock server.
const DefaultTokenURL = "{{.Auth.TokenURL}}"

// RefreshConfig carries the OAuth client credentials and target URL.
type RefreshConfig struct {
	ClientID     string
	ClientSecret string
	TokenURL     string
}

// LoadRefreshConfig pulls the OAuth credentials from config.toml first,
// then lets env vars override. Matches the precedence semantics of
// internal/config.Load — file is the persistent source of truth, env is
// the per-process override (used by tests, verify subprocess, and
// multi-account setups). An env-only loader silently breaks cron and
// non-Claude shells where the OAuth refresh would fire with empty
// credentials. {{envPrefix .Name}}_TOKEN_URL remains env-only.
func LoadRefreshConfig() RefreshConfig {
	tokenURL := DefaultTokenURL
	if v := os.Getenv("{{envPrefix .Name}}_TOKEN_URL"); v != "" {
		tokenURL = v
	}

	// Best-effort load of config.toml. A read failure (file missing,
	// parse error) returns an empty cfg with no error from config.Load
	// in the file-missing case; a parse error returns nil cfg + err and
	// we fall back to env-only rather than failing the refresh call
	// here. The downstream forceRefreshLocked still rejects an empty
	// ClientID/Secret with a clear error.
	clientID, clientSecret := "", ""
	if cfg, err := config.Load(""); err == nil && cfg != nil {
		clientID = cfg.ClientID
		clientSecret = cfg.ClientSecret
	}

	if v := os.Getenv("{{envPrefix .Name}}_CLIENT_ID"); v != "" {
		clientID = v
	}
	if v := os.Getenv("{{envPrefix .Name}}_CLIENT_SECRET"); v != "" {
		clientSecret = v
	}

	return RefreshConfig{
		ClientID:     clientID,
		ClientSecret: clientSecret,
		TokenURL:     tokenURL,
	}
}

// acquireRefreshLock takes an exclusive interprocess lock on storePath +
// ".lock" for the duration of a refresh sequence. Without this, two
// {{modulePath}} processes (e.g. cron and an interactive session) that
// both enter the refresh window can load the same refresh_token, fire
// concurrent rotations, and one of them ends up trying to use the
// already-spent refresh_token — back to the original re-OAuth bug this
// CLI exists to fix. Returns a release function the caller must defer.
//
// The provider-side rotation is atomic, so the LATE process either
// short-circuits on the re-read (we re-Load tokens after acquiring the
// lock; see RefreshIfNeeded) or rotates again cleanly with the freshly
// persisted refresh_token. Either way, no spent token gets resubmitted.
//
// macOS + Linux: syscall.Flock(LOCK_EX). Windows is unsupported by this
// CLI today; this lock fails open there. Acceptable: process-local
// refreshMu still guards within a single process.
func acquireRefreshLock(storePath string) (func(), error) {
	if storePath == "" {
		// Empty path means we can't derive a lock file. Fall back to
		// no-op release; process-local refreshMu still protects within
		// this process.
		return func() {}, nil
	}
	lockPath := storePath + ".lock"
	if err := os.MkdirAll(filepath.Dir(lockPath), 0o700); err != nil {
		return nil, fmt.Errorf("creating refresh lock dir: %w", err)
	}
	f, err := os.OpenFile(lockPath, os.O_CREATE|os.O_RDWR, 0o600)
	if err != nil {
		return nil, fmt.Errorf("opening refresh lock %s: %w", lockPath, err)
	}
	if err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX); err != nil {
		_ = f.Close()
		return nil, fmt.Errorf("acquiring refresh lock %s: %w", lockPath, err)
	}
	return func() {
		_ = syscall.Flock(int(f.Fd()), syscall.LOCK_UN)
		_ = f.Close()
	}, nil
}

// tokenResponse mirrors the provider token response envelope. status=0
// means success; on success the body field carries the access/refresh
// pair. On non-zero status, error is populated.
type tokenResponse struct {
	Status int             `json:"status"`
	Body   json.RawMessage `json:"body"`
	Error  string          `json:"error,omitempty"`
}

// tokenResponseBody captures the OAuth token-exchange/refresh response.
// We intentionally do NOT model `userid` here — some providers emit it as a
// string during the initial authorization-code exchange but as a number during
// the refresh flow, and we don't use it for any logic. Unknown JSON fields are
// silently dropped by encoding/json, which is exactly what we want.
type tokenResponseBody struct {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	ExpiresIn    int    `json:"expires_in"`
	Scope        string `json:"scope"`
	TokenType    string `json:"token_type"`
}

// RefreshIfNeeded checks the current tokens' expiry against threshold
// and proactively refreshes if expiry is within threshold (or already
// passed). Returns (tokens, refreshed, err). On refresh, the new tokens
// are persisted via store.Save BEFORE the function returns; if Save
// fails the new tokens are NOT returned to the caller (they're lost,
// but at least the old ones still work for the next call).
//
// threshold of zero defaults to 5 minutes.
//
// Honors cliutil.IsVerifyEnv: in verify-without-live-http mode this
// returns the existing tokens unchanged so verify subprocesses don't
// dial the real token endpoint.
func RefreshIfNeeded(ctx context.Context, cfg RefreshConfig, store Store, threshold time.Duration) (*Tokens, bool, error) {
	if threshold == 0 {
		threshold = 5 * time.Minute
	}
	refreshMu.Lock()
	defer refreshMu.Unlock()

	// Acquire interprocess lock — protects against cross-process refresh
	// races (cron + interactive session, two SessionStart hooks, etc.).
	// After the lock is held, store.Load() picks up any rotation a
	// peer process just persisted, allowing this call to short-circuit
	// on the expiry check below.
	unlock, err := acquireRefreshLock(store.Path())
	if err != nil {
		return nil, false, err
	}
	defer unlock()

	current, err := store.Load()
	if err != nil {
		return nil, false, err
	}
	if current.RefreshToken == "" {
		return current, false, fmt.Errorf("no refresh_token in store — run `{{modulePath}} login`")
	}

	now := time.Now()
	if !current.ExpiresAt.IsZero() && current.ExpiresAt.Sub(now) > threshold {
		return current, false, nil
	}

	if cliutil.IsVerifyEnv() && !cliutil.IsVerifyLiveHTTPEnv() {
		// Verify mode: extend expiry by 1 hour and return without dialing.
		current.ExpiresAt = now.Add(1 * time.Hour)
		return current, false, nil
	}

	return forceRefreshLocked(ctx, cfg, store, current)
}

// ForceRefresh refreshes the access token unconditionally, persists
// the new tokens, and appends an audit entry. Used by `tokens
// rotate-test` and by manual `tokens refresh` invocations.
func ForceRefresh(ctx context.Context, cfg RefreshConfig, store Store) (*Tokens, error) {
	refreshMu.Lock()
	defer refreshMu.Unlock()

	// Interprocess lock — see RefreshIfNeeded for rationale. ForceRefresh
	// has no expiry short-circuit, so on lock contention this call will
	// always perform a fresh rotation against whatever refresh_token is
	// in tokens.json at the moment the lock is acquired (which may be
	// the value a peer process just persisted).
	unlock, err := acquireRefreshLock(store.Path())
	if err != nil {
		return nil, err
	}
	defer unlock()

	current, err := store.Load()
	if err != nil {
		return nil, err
	}
	if current.RefreshToken == "" {
		return nil, fmt.Errorf("no refresh_token in store — run `{{modulePath}} login`")
	}
	t, _, err := forceRefreshLocked(ctx, cfg, store, current)
	return t, err
}

// forceRefreshLocked is the real worker. The mutex MUST already be held.
// Returns (new tokens, refreshed=true, err). On error returns the
// original tokens for callers that want to keep using them rather
// than re-prompting login.
func forceRefreshLocked(ctx context.Context, cfg RefreshConfig, store Store, current *Tokens) (*Tokens, bool, error) {
	if cfg.ClientID == "" || cfg.ClientSecret == "" {
		return current, false, fmt.Errorf("{{envPrefix .Name}}_CLIENT_ID and {{envPrefix .Name}}_CLIENT_SECRET must be set")
	}
	tokenURL := cfg.TokenURL
	if tokenURL == "" {
		tokenURL = DefaultTokenURL
	}

	form := url.Values{}
	form.Set("action", "requesttoken")
	form.Set("grant_type", "refresh_token")
	form.Set("client_id", cfg.ClientID)
	form.Set("client_secret", cfg.ClientSecret)
	form.Set("refresh_token", current.RefreshToken)

	req, err := http.NewRequestWithContext(ctx, http.MethodPost, tokenURL, strings.NewReader(form.Encode()))
	if err != nil {
		return current, false, fmt.Errorf("building refresh request: %w", err)
	}
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.Header.Set("Accept", "application/json")

	// Pace the call through the package-level AdaptiveLimiter so back-to-back
	// refreshes (rotate-test, simultaneous CLI launches) don't burst past
	// what the provider tolerates. On 429 below we call OnRateLimit so the next
	// caller gets a halved rate; on 2xx we call OnSuccess so a healthy
	// endpoint ramps back up.
	refreshLimiter.Wait()

	client := &http.Client{Timeout: 30 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		_ = AppendAudit(AuditEvent{
			Event:            "refresh",
			OldRefreshSuffix: Suffix(current.RefreshToken),
			FsyncOK:          false,
			Reason:           fmt.Sprintf("transport: %v", err),
		})
		return current, false, fmt.Errorf("refreshing token: %w", err)
	}
	defer resp.Body.Close()

	body, _ := io.ReadAll(resp.Body)
	if resp.StatusCode == http.StatusTooManyRequests {
		refreshLimiter.OnRateLimit()
		retryAfter := parseRetryAfter(resp.Header.Get("Retry-After"))
		_ = AppendAudit(AuditEvent{
			Event:            "refresh",
			OldRefreshSuffix: Suffix(current.RefreshToken),
			FsyncOK:          false,
			Reason:           fmt.Sprintf("http 429 (rate-limited; retry-after=%s): %s", retryAfter, truncate(string(body), 200)),
		})
		return current, false, &RateLimitError{
			RetryAfter: retryAfter,
			Body:       truncate(string(body), 400),
		}
	}
	if resp.StatusCode != 200 {
		_ = AppendAudit(AuditEvent{
			Event:            "refresh",
			OldRefreshSuffix: Suffix(current.RefreshToken),
			FsyncOK:          false,
			Reason:           fmt.Sprintf("http %d: %s", resp.StatusCode, truncate(string(body), 200)),
		})
		return current, false, fmt.Errorf("refresh returned HTTP %d: %s", resp.StatusCode, truncate(string(body), 400))
	}
	refreshLimiter.OnSuccess()

	var envelope tokenResponse
	if err := json.Unmarshal(body, &envelope); err != nil {
		return current, false, fmt.Errorf("parsing refresh response: %w", err)
	}
	if envelope.Status != 0 {
		msg := envelope.Error
		if msg == "" {
			msg = fmt.Sprintf("status=%d", envelope.Status)
		}
		_ = AppendAudit(AuditEvent{
			Event:            "refresh",
			OldRefreshSuffix: Suffix(current.RefreshToken),
			FsyncOK:          false,
			Reason:           msg,
		})
		return current, false, fmt.Errorf("{{humanName .Name}} refresh failed: %s", msg)
	}
	var inner tokenResponseBody
	if err := json.Unmarshal(envelope.Body, &inner); err != nil {
		return current, false, fmt.Errorf("parsing refresh body: %w", err)
	}
	if inner.AccessToken == "" || inner.RefreshToken == "" {
		return current, false, fmt.Errorf("refresh response missing tokens")
	}

	now := time.Now().UTC()
	updated := &Tokens{
		AccessToken:    inner.AccessToken,
		RefreshToken:   inner.RefreshToken,
		ExpiresAt:      now.Add(time.Duration(inner.ExpiresIn) * time.Second),
		ObtainedAt:     now,
		Scope:          firstNonEmpty(inner.Scope, current.Scope),
		ClientIDSuffix: ClientIDSuffix(cfg.ClientID),
		RotationCount:  current.RotationCount + 1,
		LastRotationAt: now,
	}

	// Persist BEFORE returning. If Save fails we DO NOT return the new
	// tokens — the caller keeps using the old ones for the next call,
	// because returning a token we didn't persist is exactly the bug
	// every other provider client has. Better to fail loudly here.
	if err := store.Save(updated); err != nil {
		_ = AppendAudit(AuditEvent{
			Event:            "refresh",
			OldRefreshSuffix: Suffix(current.RefreshToken),
			NewRefreshSuffix: Suffix(updated.RefreshToken),
			FsyncOK:          false,
			Reason:           fmt.Sprintf("save: %v", err),
		})
		return current, false, fmt.Errorf("persisting refreshed token: %w", err)
	}

	_ = AppendAudit(AuditEvent{
		Event:            "refresh",
		OldRefreshSuffix: Suffix(current.RefreshToken),
		NewRefreshSuffix: Suffix(updated.RefreshToken),
		FsyncOK:          true,
		ExpiresAt:        updated.ExpiresAt,
		RotationCount:    updated.RotationCount,
	})
	return updated, true, nil
}

func firstNonEmpty(a, b string) string {
	if a != "" {
		return a
	}
	return b
}

func truncate(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "..."
}
