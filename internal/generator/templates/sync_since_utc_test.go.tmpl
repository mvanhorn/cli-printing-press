// TestSyncSince_FlagEmitsUTCTimestamp verifies that the --since flag value is
// serialized with a Z suffix regardless of the server's local timezone.
// Regression test for https://github.com/mvanhorn/cli-printing-press/issues/3671:
// .Format(time.RFC3339) on a local-zone time.Time emits a numeric offset like
// -04:00 which strict APIs (e.g. Granola updated_after) reject with HTTP 400.
func TestSyncSince_FlagEmitsUTCTimestamp(t *testing.T) {
	t.Parallel()
	cases := []string{"7d", "24h", "1w", "30m"}
	for _, since := range cases {
		ts, err := parseSinceDuration(since)
		if err != nil {
			t.Fatalf("parseSinceDuration(%q): %v", since, err)
		}
		formatted := ts.UTC().Format(time.RFC3339)
		if !strings.HasSuffix(formatted, "Z") {
			t.Errorf("since=%q: formatted timestamp %q does not end with Z", since, formatted)
		}
		// Must still be valid RFC3339
		if _, err := time.Parse(time.RFC3339, formatted); err != nil {
			t.Errorf("since=%q: formatted timestamp %q is not valid RFC3339: %v", since, formatted, err)
		}
	}
}

// TestSyncSince_ResumeFromDBEmitsUTCTimestamp verifies that the lastSynced
// resume cursor from db.GetSyncState is also normalized to UTC before
// formatting. This path is independent of the --since flag and was also
// affected by the bug.
func TestSyncSince_ResumeFromDBEmitsUTCTimestamp(t *testing.T) {
	t.Parallel()
	// Simulate a lastSynced value in a non-UTC zone (America/New_York = -04:00 EDT).
	loc, err := time.LoadLocation("America/New_York")
	if err != nil {
		t.Skip("America/New_York timezone not available in this environment")
	}
	lastSynced := time.Date(2026, 7, 12, 10, 0, 0, 0, loc) // 10:00 EDT = 14:00 UTC

	formatted := lastSynced.UTC().Format(time.RFC3339)

	if !strings.HasSuffix(formatted, "Z") {
		t.Errorf("resume cursor: got %q, want Z suffix", formatted)
	}
	if formatted != "2026-07-12T14:00:00Z" {
		t.Errorf("resume cursor: got %q, want 2026-07-12T14:00:00Z (same instant in UTC)", formatted)
	}
}

