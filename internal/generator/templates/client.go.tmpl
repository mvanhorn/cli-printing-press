		BaseURL:    strings.TrimRight(cfg.BaseURL, "/"),
{{- if .BasePath}}
		BasePath:   normalizeBasePath(cfg.BasePath),
{{- end}}
		Config:     cfg,
		HTTPClient: httpClient,
		cacheDir:   cacheDir,
		limiter:    newRateLimiter(rateLimit),
{{- if .HasTierRouting}}
