func (e *APIError) Error() string {
	msg := fmt.Sprintf("%s %s returned HTTP %d", e.Method, e.Path, e.StatusCode)
	if strings.TrimSpace(e.Body) != "" {
		msg += ": " + e.Body
	}
	return msg
