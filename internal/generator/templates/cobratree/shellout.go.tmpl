	for i, t := range tokens {
		if !positionalWriteSinks[i] {
			continue
		}
		if strings.TrimSpace(t) == "" || t == "-" {
			continue
		}
		return fmt.Errorf("positional argument %d writes to %q; file output is not available for read-only MCP tools", i+1, t)
	}
	return nil
}

