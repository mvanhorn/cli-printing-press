func explicitProfile(t *testing.T) (profile, configPath, credsPath string) {
	t.Helper()
	profile = t.TempDir()
	configPath = filepath.Join(profile, "config.toml")
	if err := os.WriteFile(configPath, nil, 0o600); err != nil {
		t.Fatal(err)
	}
	var err error
	credsPath, err = CredentialsFilePathForConfig(configPath)
	if err != nil {
		t.Fatal(err)
	}
	return profile, configPath, credsPath
}

func resetExplicitCredentialHooks(t *testing.T) {
	t.Helper()
	explicitCredentialPinnedHook = nil
	explicitCredentialTempHook = nil
	explicitCredentialPublishHook = nil
	t.Cleanup(func() {
		explicitCredentialPinnedHook = nil
		explicitCredentialTempHook = nil
		explicitCredentialPublishHook = nil
	})
}

func TestResolveConfigFilePathForExplicitProfile(t *testing.T) {
	_, err := ResolveConfigFilePath("  ")
	if err == nil {
		t.Fatal("empty config path should fail")
	}
	if _, err := ResolveConfigFilePath("bad\x00path"); err == nil {
		t.Fatal("config path with a NUL should fail")
	}

	root := t.TempDir()
	missingParent := filepath.Join(root, "missing", "config.toml")
	got, err := ResolveConfigFilePath(missingParent)
	if err != nil {
		t.Fatal(err)
	}
	if got != missingParent {
		t.Fatalf("missing parent path = %q, want %q", got, missingParent)
	}

	profile := filepath.Join(root, "profile")
	if err := os.Mkdir(profile, 0o700); err != nil {
		t.Fatal(err)
	}
	target := filepath.Join(profile, "config.toml")
	if err := os.WriteFile(target, []byte("base_url = \"https://api.example.com\"\n"), 0o600); err != nil {
		t.Fatal(err)
	}
	resolvedTarget, err := filepath.EvalSymlinks(target)
	if err != nil {
		t.Fatal(err)
	}
	uncreated := filepath.Join(profile, "new.toml")
	got, err = ResolveConfigFilePath(uncreated)
	if err != nil {
		t.Fatal(err)
	}
	if want := filepath.Join(filepath.Dir(resolvedTarget), "new.toml"); got != want {
		t.Fatalf("missing file in an existing profile = %q, want %q", got, want)
	}

	dotdot := filepath.Join(root, "side", "..", "profile", "config.toml")
	if err := os.Mkdir(filepath.Join(root, "side"), 0o700); err != nil {
		t.Fatal(err)
	}
	got, err = ResolveConfigFilePath(dotdot)
	if err != nil {
		t.Fatal(err)
	}
	if got != resolvedTarget {
		t.Fatalf("dotdot path = %q, want %q", got, resolvedTarget)
	}

	alias := filepath.Join(root, "alias")
	if err := os.Mkdir(alias, 0o700); err != nil {
		t.Fatal(err)
	}
	link := filepath.Join(alias, "config.toml")
	if err := os.Symlink(filepath.Join("..", "profile", "config.toml"), link); err != nil {
		t.Skipf("symlinks unavailable: %v", err)
	}
	got, err = ResolveConfigFilePath(link)
	if err != nil {
		t.Fatal(err)
	}
	if got != resolvedTarget {
		t.Fatalf("symlink path = %q, want %q", got, resolvedTarget)
	}
	via := filepath.Join(root, "side", "..", "alias", "config.toml")
	got, err = ResolveConfigFilePath(via)
	if err != nil {
		t.Fatal(err)
	}
	if got != resolvedTarget {
		t.Fatalf("relative symlink path = %q, want %q", got, resolvedTarget)
	}

	creds, err := CredentialsFilePathForConfig(via)
	if err != nil {
		t.Fatal(err)
	}
	if want := filepath.Join(filepath.Dir(resolvedTarget), "data", credentialsFileName); creds != want {
		t.Fatalf("credentials path = %q, want %q", creds, want)
	}
}

func assertFileBytes(t *testing.T, path string, want []byte) {
	t.Helper()
	got, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	if string(got) != string(want) {
		t.Fatalf("file %s = %q, want %q", path, got, want)
	}
}

func dirNames(t *testing.T, dir string) []string {
	t.Helper()
	entries, err := os.ReadDir(dir)
	if err != nil {
		t.Fatal(err)
	}
	names := make([]string, 0, len(entries))
	for _, entry := range entries {
		names = append(names, entry.Name())
	}
	return names
}

func assertDirUnchanged(t *testing.T, dir string, before []string) {
	t.Helper()
	after := dirNames(t, dir)
	if strings.Join(before, "\n") != strings.Join(after, "\n") {
		t.Fatalf("directory %s entries = %v, want %v", dir, after, before)
	}
}

func treeContainsSecret(t *testing.T, root, needle string) bool {
	t.Helper()
	found := false
	err := filepath.Walk(root, func(path string, info os.FileInfo, walkErr error) error {
		if walkErr != nil || info == nil || !info.Mode().IsRegular() {
			return nil
		}
		data, readErr := os.ReadFile(path)
		if readErr == nil && strings.Contains(string(data), needle) {
			found = true
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	return found
}
