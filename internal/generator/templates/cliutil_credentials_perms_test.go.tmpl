// TestLoadCredentials_RefusesOverPermissiveFileOnRead: an owner-locked
// credentials file is a hit (ok=true, token surfaced); broadening it to
// group/world-readable makes LoadCredentials a soft miss while the status path
// reports the refused credential.
func TestLoadCredentials_RefusesOverPermissiveFileOnRead(t *testing.T) {
