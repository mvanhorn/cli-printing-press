func TestSaveExplicitCredentialsRejectsLooseFileAfterRename(t *testing.T) {
	if runtime.GOOS == "windows" {
		t.Skip("POSIX mode bits")
	}
	_, _, credsPath := explicitProfile(t)
	resetExplicitCredentialHooks(t)
	explicitCredentialPublishHook = func() {
		if err := os.Chmod(credsPath, 0o644); err != nil {
			t.Errorf("chmod published file: %v", err)
		}
	}
	err := SaveExplicitCredentials(credsPath, &Credentials{AccessToken: "published-secret"})
	var permErr *CredentialsPermissionError
	if err == nil || !errors.As(err, &permErr) {
		t.Fatalf("SaveExplicitCredentials() error = %v, want CredentialsPermissionError", err)
	}
	if permErr.Path != credsPath {
		t.Fatalf("permission error path = %q, want %q", permErr.Path, credsPath)
	}
	info, statErr := os.Stat(credsPath)
	if statErr != nil {
		t.Fatal(statErr)
	}
	if info.Mode().Perm() != 0o644 {
		t.Fatalf("published mode = %o, want 0644", info.Mode().Perm())
	}
}

