// Read-time permission enforcement for the persisted credentials file: a
// separate file from the config, holding its own live token. LoadCredentials
// keeps the legacy soft-miss wrapper while LoadCredentialsWithStatus reports a
// refusal distinct from genuine absence. This is an in-package (package
// cliutil) test so it can drive credentialsPath() and VerifyCredsPerms directly.
// Cross-platform: POSIX chmod + Windows icacls, skip-guarded; the on-disk token
// uses the always-present AccessToken slot so assertions stay field-agnostic.
package cliutil

import (
	"errors"
	"io"
	"os"
	"os/exec"
	"path/filepath"
	"runtime"
	"strings"
	"testing"

	"{{modulePath}}/internal/cliutil/testenv"
