// credsSampleReadPermsToken is an exposed on-disk token value written to the
// always-present AccessToken slot.
const credsSampleReadPermsToken = "AT-LIVE-CREDS-FILE-DO-NOT-LEAK"

// isolateCredsHome points DataDir() (hence credentialsPath()) at a throwaway
// home so the test never reads or writes the developer's real credentials file.
func isolateCredsHome(t *testing.T) {
	t.Helper()
	restore, err := SetHomeOverride("")
	if err != nil {
		t.Fatalf("reset home override: %v", err)
	}
	t.Cleanup(restore)
	testenv.Isolate(t, DataDir)
}

func runCredsPermsCmd(t *testing.T, name string, args ...string) error {
	t.Helper()
	out, err := exec.Command(name, args...).CombinedOutput()
	if err != nil {
		t.Logf("%s %v: %v\n%s", name, args, err, out)
	}
	return err
}

func resetCredsPermsWarnings() {
	credentialsWarnedMu.Lock()
	defer credentialsWarnedMu.Unlock()
	credentialsWarned = map[string]struct{}{}
}

func captureCredsPermsStderr(t *testing.T, fn func()) string {
	t.Helper()
	oldStderr := os.Stderr
	r, w, err := os.Pipe()
	if err != nil {
		t.Fatal(err)
	}
	os.Stderr = w
	defer func() {
		os.Stderr = oldStderr
		r.Close()
	}()
	fn()
	w.Close()
	out, err := io.ReadAll(r)
	if err != nil {
		t.Fatal(err)
	}
	return string(out)
}

// credsLockOwnerOnly restricts p to owner-only access (POSIX 0600 / Windows DACL
// to the current user). icacls failures skip the test rather than fail it.
func credsLockOwnerOnly(t *testing.T, p string) {
	t.Helper()
	if runtime.GOOS == "windows" {
		u := os.Getenv("USERNAME")
		if err := runCredsPermsCmd(t, "icacls", p, "/inheritance:r", "/grant:r", u+":F"); err != nil {
			t.Skipf("icacls lock failed (environment); skipping perm-sensitive test: %v", err)
		}
	} else if err := os.Chmod(p, 0o600); err != nil {
		t.Fatal(err)
	}
}

// credsGrantBroad makes p group/world-accessible (POSIX 0644 / Windows adds a
// broad BUILTIN\Users allow-ACE by SID, locale-independent). icacls failures skip.
func credsGrantBroad(t *testing.T, p string) {
	t.Helper()
	if runtime.GOOS == "windows" {
		if err := runCredsPermsCmd(t, "icacls", p, "/grant", "*S-1-5-32-545:R"); err != nil {
			t.Skipf("icacls grant failed; skipping: %v", err)
		}
	} else if err := os.Chmod(p, 0o644); err != nil {
		t.Fatal(err)
	}
}

// TestLoadCredentials_RefusesOverPermissiveFileOnRead: an owner-locked
// credentials file is a hit (ok=true, token surfaced); broadening it to
// group/world-readable makes LoadCredentials a soft miss while the status path
// reports the refused credential.
func TestLoadCredentials_RefusesOverPermissiveFileOnRead(t *testing.T) {
	isolateCredsHome(t)
	resetCredsPermsWarnings()

	if err := SaveCredentials(&Credentials{AccessToken: credsSampleReadPermsToken}); err != nil {
		t.Fatalf("SaveCredentials() error = %v", err)
	}
	path, err := credentialsPath()
	if err != nil {
		t.Fatalf("credentialsPath() error = %v", err)
	}

	// Owner-locked (SaveCredentials writes 0600) → honored: a hit that surfaces
	// the token from the always-present AccessToken slot.
	credsLockOwnerOnly(t, path)
	creds, status, err := LoadCredentialsWithStatus()
	if err != nil {
		t.Fatalf("LoadCredentialsWithStatus() on owner-locked file error = %v", err)
	}
	if !status.Loaded || creds == nil {
		t.Fatal("precondition: owner-locked credentials file should be a hit")
	}
	if status.Refusal != nil {
		t.Fatalf("owner-locked credentials file should not report a refusal: %#v", status.Refusal)
	}
	if creds.AccessToken != credsSampleReadPermsToken {
		t.Fatalf("precondition: owner-locked file should load the token, got %q", creds.AccessToken)
	}

	// Broaden perms → the credentials file holding a live token MUST be refused
	// on read: a soft miss with refusal state, never trusted, never an error.
	credsGrantBroad(t, path)
	var ok bool
	stderr := captureCredsPermsStderr(t, func() {
		creds, status, err = LoadCredentialsWithStatus()
	})
	if err != nil {
		t.Fatalf("over-permissive credentials file must be a soft miss, got error: %v", err)
	}
	if status.Loaded {
		t.Error("over-permissive credentials file must be a miss (Loaded=false)")
	}
	if creds != nil {
		t.Errorf("over-permissive credentials file must surface no credential, got %+v", creds)
	}
	if status.Refusal == nil {
		t.Fatal("over-permissive credentials file should report a refusal")
	}
	if !status.Refusal.CredentialsPresent {
		t.Fatal("refusal should record that a credential was dropped")
	}
	if status.Refusal.Path != path {
		t.Fatalf("refusal path = %q, want %q", status.Refusal.Path, path)
	}
	if !strings.Contains(stderr, "error:") || !strings.Contains(stderr, "refused") {
		t.Fatalf("stderr = %q, want error severity refusal", stderr)
	}

	// The legacy wrapper keeps the soft miss contract for existing callers.
	creds, ok, err = LoadCredentials()
	if err != nil {
		t.Fatalf("LoadCredentials() wrapper error = %v", err)
	}
	if ok || creds != nil {
		t.Fatalf("LoadCredentials() wrapper = (%#v, %v), want soft miss", creds, ok)
	}

	// The reporter dedupes stderr only. A second status load in the same process
	// must still return refusal state so config.Load never confuses it with absence.
	stderr = captureCredsPermsStderr(t, func() {
		creds, status, err = LoadCredentialsWithStatus()
	})
	if err != nil {
		t.Fatalf("second LoadCredentialsWithStatus() error = %v", err)
	}
	if stderr != "" {
		t.Fatalf("second refusal print should be deduped, got %q", stderr)
	}
	if status.Refusal == nil || !status.Refusal.CredentialsPresent {
		t.Fatalf("second status lost refusal state: %#v", status.Refusal)
	}
	if creds != nil || status.Loaded {
		t.Fatalf("second status should remain a soft miss, got creds=%#v status=%#v", creds, status)
	}
}

func TestLoadCredentials_MissingFileIsAbsentNotRefused(t *testing.T) {
	isolateCredsHome(t)
	resetCredsPermsWarnings()

	creds, status, err := LoadCredentialsWithStatus()
	if err != nil {
		t.Fatalf("LoadCredentialsWithStatus() on missing file error = %v", err)
	}
	if status.Loaded || creds != nil {
		t.Fatalf("missing credentials file = (%#v, %#v), want absent soft miss", creds, status)
	}
	if status.Refusal != nil {
		t.Fatalf("missing credentials file should not report a refusal: %#v", status.Refusal)
	}
}

// TestSaveCredentialsVerifiesWrittenFile exercises the NTFS case where a
// credentials file inherits a broad ACE even though the writer requested 0600.
func TestSaveCredentialsVerifiesWrittenFile(t *testing.T) {
	isolateCredsHome(t)
	dataDir, err := DataDir()
	if err != nil {
		t.Fatalf("DataDir() error = %v", err)
	}
	if err := os.MkdirAll(dataDir, 0o700); err != nil {
		t.Fatalf("mkdir data dir: %v", err)
	}
	if runtime.GOOS == "windows" {
		if err := runCredsPermsCmd(t, "icacls", dataDir, "/grant", "*S-1-5-32-545:(OI)(CI)(R)"); err != nil {
			t.Skipf("icacls inherited grant failed; skipping environment-sensitive test: %v", err)
		}
		err = SaveCredentials(&Credentials{AccessToken: credsSampleReadPermsToken})
		var permissionErr *CredentialsPermissionError
		if err == nil || !strings.Contains(err.Error(), "permissions") || !errors.As(err, &permissionErr) {
			t.Fatalf("SaveCredentials() error = %v, want post-save permission refusal", err)
		}
		if permissionErr.Path != filepath.Join(dataDir, credentialsFileName) {
			t.Fatalf("permission error path = %q, want %q", permissionErr.Path, filepath.Join(dataDir, credentialsFileName))
		}
		data, readErr := os.ReadFile(permissionErr.Path)
		if readErr != nil {
			t.Fatalf("read saved credentials after permission refusal: %v", readErr)
		}
		if !strings.Contains(string(data), credsSampleReadPermsToken) {
			t.Fatalf("saved credentials do not contain test token: %q", data)
		}
		return
	}
	if err := SaveCredentials(&Credentials{AccessToken: credsSampleReadPermsToken}); err != nil {
		t.Fatalf("SaveCredentials() on a normal POSIX file error = %v", err)
	}
}
