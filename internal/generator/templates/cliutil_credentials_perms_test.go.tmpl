	if err := os.MkdirAll(dataDir, 0o700); err != nil {
		t.Fatal(err)
	}
	foreign := t.TempDir()
	if err := os.WriteFile(filepath.Join(foreign, "marker"), []byte("foreign-marker"), 0o600); err != nil {
		t.Fatal(err)
	}
	resetExplicitCredentialHooks(t)
	explicitCredentialPinnedHook = func() {
		if err := os.Rename(dataDir, dataDir+".real"); err != nil {
			t.Errorf("rename data: %v", err)
			return
		}
		if err := os.Symlink(foreign, dataDir); err != nil {
			t.Errorf("symlink data: %v", err)
		}
	}
	err := SaveExplicitCredentials(credsPath, &Credentials{AccessToken: "swap-secret"})
	if err == nil || !strings.Contains(err.Error(), "symlink") {
		t.Fatalf("SaveExplicitCredentials() error = %v, want a symlink refusal", err)
	}
	if treeContainsSecret(t, foreign, "swap-secret") || treeContainsSecret(t, dataDir+".real", "swap-secret") {
		t.Fatal("swapped data directory received the secret")
	}
}

