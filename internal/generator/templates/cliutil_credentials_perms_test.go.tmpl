	resetCredsPermsWarnings()

	if err := SaveCredentials(&Credentials{AccessToken: credsSampleReadPermsToken}); err != nil {
		t.Fatalf("SaveCredentials() error = %v", err)
	}
	path, err := credentialsPath()
	if err != nil {
		t.Fatalf("credentialsPath() error = %v", err)
	}

	// Owner-locked (SaveCredentials writes 0600) → honored: a hit that surfaces
	// the token from the always-present AccessToken slot.
	credsLockOwnerOnly(t, path)
	creds, status, err := LoadCredentialsWithStatus()
	if err != nil {
		t.Fatalf("LoadCredentialsWithStatus() on owner-locked file error = %v", err)
	}
	if !status.Loaded || creds == nil {
		t.Fatal("precondition: owner-locked credentials file should be a hit")
	}
	if status.Refusal != nil {
		t.Fatalf("owner-locked credentials file should not report a refusal: %#v", status.Refusal)
	}
	if creds.AccessToken != credsSampleReadPermsToken {
		t.Fatalf("precondition: owner-locked file should load the token, got %q", creds.AccessToken)
	}

	// Broaden perms → the credentials file holding a live token MUST be refused
	// on read: a soft miss with refusal state, never trusted, never an error.
	credsGrantBroad(t, path)
	var ok bool
	stderr := captureCredsPermsStderr(t, func() {
		creds, status, err = LoadCredentialsWithStatus()
	})
	if err != nil {
		t.Fatalf("over-permissive credentials file must be a soft miss, got error: %v", err)
	}
	if status.Loaded {
		t.Error("over-permissive credentials file must be a miss (Loaded=false)")
	}
	if creds != nil {
		t.Errorf("over-permissive credentials file must surface no credential, got %+v", creds)
	}
	if status.Refusal == nil {
		t.Fatal("over-permissive credentials file should report a refusal")
	}
	if !status.Refusal.CredentialsPresent {
		t.Fatal("refusal should record that a credential was dropped")
	}
	if status.Refusal.Path != path {
		t.Fatalf("refusal path = %q, want %q", status.Refusal.Path, path)
	}
	if !strings.Contains(stderr, "error:") || !strings.Contains(stderr, "refused") {
		t.Fatalf("stderr = %q, want error severity refusal", stderr)
	}

	// The legacy wrapper keeps the soft miss contract for existing callers.
	creds, ok, err = LoadCredentials()
	if err != nil {
		t.Fatalf("LoadCredentials() wrapper error = %v", err)
	}
	if ok || creds != nil {
		t.Fatalf("LoadCredentials() wrapper = (%#v, %v), want soft miss", creds, ok)
	}

	// The reporter dedupes stderr only. A second status load in the same process
	// must still return refusal state so config.Load never confuses it with absence.
	stderr = captureCredsPermsStderr(t, func() {
		creds, status, err = LoadCredentialsWithStatus()
	})
	if err != nil {
		t.Fatalf("second LoadCredentialsWithStatus() error = %v", err)
	}
	if stderr != "" {
		t.Fatalf("second refusal print should be deduped, got %q", stderr)
	}
	if status.Refusal == nil || !status.Refusal.CredentialsPresent {
		t.Fatalf("second status lost refusal state: %#v", status.Refusal)
	}
	if creds != nil || status.Loaded {
		t.Fatalf("second status should remain a soft miss, got creds=%#v status=%#v", creds, status)
	}
}

