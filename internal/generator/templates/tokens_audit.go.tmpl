}

// AppendAudit writes one NDJSON line, append-only, with mode 0600 on
// the file. Best-effort: returns the error but never panics; callers
// log it and continue. The cost of losing one audit line is small;
// the cost of crashing a refresh because of an audit-log write error
// is total auth loss.
func AppendAudit(event AuditEvent) error {
