// Suffix returns the last 4 chars of a token for safe audit logging.
// 4 chars is enough to disambiguate consecutive rotations on a single
// account without leaking the full secret.
func Suffix(token string) string {
	if len(token) <= 4 {
		return token
	}
	return token[len(token)-4:]
}
