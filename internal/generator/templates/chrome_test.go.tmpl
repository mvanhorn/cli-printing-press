	c := chromeClient(7*time.Second, nil, false)
	if c.Timeout != 7*time.Second {
		t.Fatalf("Timeout = %s, want 7s", c.Timeout)
	}
	if c.Jar == nil {
		t.Fatal("chrome client must never ship a nil cookie jar")
	}
{{- if .UsesBrowserHTTP3Transport}}
