func TestChromeHeaderTripperFillsOnlyMissingHeaders(t *testing.T) {
	rec := &recordingTripper{}
	rt := chromeHeaderTripper{next: rec}

	req, _ := http.NewRequest(http.MethodGet, "https://example.com/", nil)
	req.Header.Set("User-Agent", "caller/1.0")
	if _, err := rt.RoundTrip(req); err != nil {
		t.Fatal(err)
	}
	if got := rec.got.Get("User-Agent"); got != "caller/1.0" {
		t.Fatalf("User-Agent = %q, want the caller's value preserved", got)
	}
	if got := rec.got.Get("sec-ch-ua-platform"); got != chromeSecCHUAPlatform {
		t.Fatalf("sec-ch-ua-platform = %q, want %q", got, chromeSecCHUAPlatform)
	}
	if req.Header.Get("sec-ch-ua") != "" {
		t.Fatal("tripper mutated the caller's request instead of cloning it")
	}

	bare, _ := http.NewRequest(http.MethodGet, "https://example.com/", nil)
	if _, err := rt.RoundTrip(bare); err != nil {
		t.Fatal(err)
	}
	if got := rec.got.Get("User-Agent"); got != chromeUserAgent {
		t.Fatalf("User-Agent = %q, want %q", got, chromeUserAgent)
	}
	if got := rec.got.Get("Accept"); got != chromeAccept {
		t.Fatalf("Accept = %q, want %q", got, chromeAccept)
	}
}
