func TestWindowTruncationAndAnalyticsConformance(t *testing.T) {
	now := time.Date(2026, time.March, 15, 12, 0, 0, 0, time.UTC)
	window, err := ResolveWindow(WindowRequest{Days: 90, Timezone: "UTC"}, WindowPolicy{Now: func() time.Time { return now }, MaximumDays: 30, ProviderMaximumName: "30d", EndExclusive: true})
	if err != nil {
		t.Fatal(err)
	}
	if !window.Clamped || !window.Start.Equal(window.End.AddDate(0, 0, -30)) {
		t.Fatalf("window was not clamped: %+v", window)
	}
	meta := OutputMetadata{}
	meta.SetWindow(window)
	meta.MarkTruncated(TruncationReason{Kind: "max_pages", Configured: 10, Observed: 10, MoreAvailable: true})
	if !meta.Truncated || len(meta.TruncationReasons) != 1 || len(meta.Warnings) != 1 {
		t.Fatalf("metadata = %+v", meta)
	}

	zero := 0.0
	declaration := AnalyticsDeclaration{
		ClientProfile:    "tenant-a",
		TenantIdentity:   map[string]string{"account_id": "acct-a"},
		DataSource:       "fixture",
		RequiredInputs:   []string{"orders", "events"},
		JoinKeys:         []string{"order_id"},
		InputRows:        map[string]int64{"orders": 2, "events": 2},
		ValidJoinKeys:    map[string]int64{"order_id": 2},
		MissingJoinKeys:  map[string]int64{"order_id": 0},
		MatchedRows:      2,
		NewestRowAt:      map[string]time.Time{},
		FreshnessStatus:  map[string]string{"orders": "unknown", "events": "unknown"},
		BusinessMetrics:  map[string]*float64{"revenue": &zero},
		MinimumInputRows: map[string]int64{"orders": 1, "events": 1},
		Remediation:      "verify fixture inputs and join coverage",
	}
	var failure *AnalyticsFailure
	if err := ValidateAnalytics(declaration); !errors.As(err, &failure) || failure.Reason != "all_business_metrics_zero_or_null" {
		t.Fatalf("all-zero analytics error = %#v", err)
	}
	assertFailure := func(name, reason string, mutate func(*AnalyticsDeclaration)) {
		t.Helper()
		candidate := declaration
		mutate(&candidate)
		failure = nil
		if err := ValidateAnalytics(candidate); !errors.As(err, &failure) || failure.Reason != reason {
			t.Fatalf("%s analytics error = %#v, want %s", name, err, reason)
		}
	}
	assertFailure("client profile", "missing_client_profile", func(candidate *AnalyticsDeclaration) { candidate.ClientProfile = "" })
	assertFailure("tenant", "missing_verified_tenant", func(candidate *AnalyticsDeclaration) { candidate.TenantIdentity = nil })
	assertFailure("data source", "missing_data_source", func(candidate *AnalyticsDeclaration) { candidate.DataSource = "" })
	assertFailure("inputs", "missing_required_inputs", func(candidate *AnalyticsDeclaration) { candidate.RequiredInputs = nil })
	assertFailure("join declaration", "missing_join_key_declaration", func(candidate *AnalyticsDeclaration) { candidate.JoinKeys = nil })
	assertFailure("input counts", "missing_input_count_declaration", func(candidate *AnalyticsDeclaration) { candidate.InputRows = nil })
	assertFailure("join diagnostics", "missing_join_key_diagnostics", func(candidate *AnalyticsDeclaration) { candidate.ValidJoinKeys = nil })
	assertFailure("freshness diagnostics", "missing_freshness_diagnostics", func(candidate *AnalyticsDeclaration) { candidate.NewestRowAt = nil })
	assertFailure("remediation", "missing_remediation", func(candidate *AnalyticsDeclaration) { candidate.Remediation = "" })
	assertFailure("metrics", "missing_business_metrics", func(candidate *AnalyticsDeclaration) { candidate.BusinessMetrics = nil })
	assertFailure("minimum", "missing_minimum_input_rows", func(candidate *AnalyticsDeclaration) { candidate.MinimumInputRows = map[string]int64{"orders": 1} })
	assertFailure("freshness status", "missing_freshness_status", func(candidate *AnalyticsDeclaration) {
		candidate.FreshnessStatus = map[string]string{"orders": "unknown"}
	})
	assertFailure("newest row", "missing_newest_row_at", func(candidate *AnalyticsDeclaration) {
		candidate.FreshnessStatus = map[string]string{"orders": "observed", "events": "unknown"}
	})
	assertFailure("freshness value", "invalid_freshness_status", func(candidate *AnalyticsDeclaration) {
		candidate.FreshnessStatus = map[string]string{"orders": "stale", "events": "unknown"}
	})
	assertFailure("minimum rows", "required_input_below_minimum", func(candidate *AnalyticsDeclaration) {
		candidate.InputRows = map[string]int64{"orders": 0, "events": 2}
	})
	assertFailure("specific join key", "missing_join_key_diagnostics", func(candidate *AnalyticsDeclaration) { candidate.ValidJoinKeys = map[string]int64{} })
	assertFailure("join matches", "nonempty_inputs_with_zero_join_matches", func(candidate *AnalyticsDeclaration) { candidate.MatchedRows = 0 })
	value := 12.0
	declaration.BusinessMetrics["revenue"] = &value
	if err := ValidateAnalytics(declaration); err != nil {
		t.Fatalf("valid analytics failed: %v", err)
	}
}

func TestResolvedWindowCalendarConformance(t *testing.T) {
	location, err := time.LoadLocation("America/Los_Angeles")
	if err != nil {
		t.Fatal(err)
	}
	resolve := func(t *testing.T, request WindowRequest, policy WindowPolicy) ResolvedWindow {
		t.Helper()
		window, err := ResolveWindow(request, policy)
		if err != nil {
			t.Fatal(err)
		}
		return window
	}

	t.Run("relative_spring_forward", func(t *testing.T) {
		now := time.Date(2026, time.March, 8, 12, 0, 0, 0, location)
		window := resolve(t, WindowRequest{Days: 1, Timezone: location.String()}, WindowPolicy{Now: func() time.Time { return now }, EndExclusive: true})
		wantStart := time.Date(2026, time.March, 7, 12, 0, 0, 0, location)
		if !window.Start.Equal(wantStart) || window.End.Sub(window.Start) != 23*time.Hour || window.Timezone != location.String() {
			t.Fatalf("spring-forward calendar day = %+v", window)
		}
	})

	t.Run("relative_fall_back", func(t *testing.T) {
		now := time.Date(2026, time.November, 1, 12, 0, 0, 0, location)
		window := resolve(t, WindowRequest{Days: 1, Timezone: location.String()}, WindowPolicy{Now: func() time.Time { return now }, EndExclusive: true})
		wantStart := time.Date(2026, time.October, 31, 12, 0, 0, 0, location)
		if !window.Start.Equal(wantStart) || window.End.Sub(window.Start) != 25*time.Hour {
			t.Fatalf("fall-back calendar day = %+v", window)
		}
	})

	t.Run("absolute_complete_calendar_days", func(t *testing.T) {
		start := time.Date(2026, time.March, 7, 0, 0, 0, 0, location)
		end := time.Date(2026, time.March, 10, 0, 0, 0, 0, location)
		window := resolve(t, WindowRequest{Start: &start, End: &end, Timezone: location.String(), CompletePeriods: true}, WindowPolicy{EndExclusive: true})
		if !window.CompletePeriods || !window.EndExclusive || window.End.Sub(window.Start) != 71*time.Hour {
			t.Fatalf("absolute complete calendar days = %+v", window)
		}
	})

	t.Run("calendar_complete_month", func(t *testing.T) {
		window := resolve(t, WindowRequest{Month: "2026-03", Timezone: location.String()}, WindowPolicy{})
		wantStart := time.Date(2026, time.March, 1, 0, 0, 0, 0, location)
		wantEnd := time.Date(2026, time.April, 1, 0, 0, 0, 0, location)
		if !window.Start.Equal(wantStart) || !window.End.Equal(wantEnd) || !window.CompletePeriods || !window.EndExclusive || window.Requested.Month != "2026-03" || window.End.Sub(window.Start) != 743*time.Hour {
			t.Fatalf("complete calendar month = %+v", window)
		}
	})

	t.Run("timezone_is_explicit", func(t *testing.T) {
		tokyo, err := time.LoadLocation("Asia/Tokyo")
		if err != nil {
			t.Fatal(err)
		}
		now := time.Date(2026, time.July, 20, 9, 30, 0, 0, tokyo)
		window := resolve(t, WindowRequest{Days: 2, Timezone: tokyo.String()}, WindowPolicy{Now: func() time.Time { return now }})
		if window.Timezone != "Asia/Tokyo" || window.Start.Location().String() != tokyo.String() || window.End.Location().String() != tokyo.String() {
			t.Fatalf("timezone resolution = %+v", window)
		}
	})

	t.Run("provider_day_cap", func(t *testing.T) {
		start := time.Date(2026, time.February, 6, 12, 0, 0, 0, location)
		end := time.Date(2026, time.March, 9, 12, 0, 0, 0, location)
		window := resolve(t, WindowRequest{Start: &start, End: &end, Timezone: location.String()}, WindowPolicy{MaximumDays: 30, ProviderMaximumName: "fixture_30_day_maximum"})
		wantStart := time.Date(2026, time.February, 7, 12, 0, 0, 0, location)
		if !window.Clamped || !window.Start.Equal(wantStart) || window.End.Sub(window.Start) != 719*time.Hour || window.ProviderMaximum != "fixture_30_day_maximum" || window.ClampReason != "requested_window_exceeds_provider_maximum" {
			t.Fatalf("calendar provider cap = %+v", window)
		}
	})
}

func TestContextCarriesOutputMetadataRecorder(t *testing.T) {
	setPlatformRoots(t)
	profile := &Profile{
		SchemaVersion: ProfileSchemaVersion,
		Name:          "synthetic",
		Sources: map[string]SourceProfile{
			"sample": {CredentialRef: "fixture://Test/sample/token", ExpectedAccountID: "one"},
		},
	}
	session, err := PrepareProfileSourceFromConfig(profile, "sample-pp-cli", "sample")
	if err != nil {
		t.Fatal(err)
	}
	ctx := ContextWithSession(context.Background(), session)
	MarkContextTruncated(ctx, TruncationReason{Kind: "max_pages", Configured: 50, Observed: 50, MoreAvailable: true})
