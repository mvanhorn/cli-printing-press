func TestRateLimitConformance(t *testing.T) {
	now := time.Date(2026, time.July, 20, 0, 0, 0, 0, time.UTC)
	if got := RetryAfterDelay("12", 0, now, rand.New(rand.NewSource(1))); got != 12*time.Second {
		t.Fatalf("delta Retry-After = %s", got)
	}
	if got := RetryAfterDelay(now.Add(8*time.Second).Format(http.TimeFormat), 0, now, rand.New(rand.NewSource(1))); got != 8*time.Second {
		t.Fatalf("date Retry-After = %s", got)
	}
	if CanRetryRequest("POST", "") || !CanRetryRequest("POST", "idempotency-key") {
		t.Fatal("non-idempotent retry contract failed")
	}
	session := &Session{rateLimit: newRateLimitRecorder()}
	session.RecordRateLimitRequest()
	session.RecordRateLimitRetry(1500 * time.Millisecond)
	session.RecordRateLimitExhausted()
	metadata := session.RateLimitMetadata()
	if metadata.Requests != 1 || metadata.Retries != 1 || metadata.WaitMS != 1500 || !metadata.Exhausted {
		t.Fatalf("rate-limit metadata = %+v", metadata)
	}
	encoded, err := json.Marshal(metadata)
	if err != nil || !strings.Contains(string(encoded), `"wait_ms":1500`) || strings.Contains(string(encoded), `"wait":`) {
		t.Fatalf("rate-limit metadata schema = %s err=%v", encoded, err)
	}
}

func TestSharedLimiterHonorsBurstAndCrossInstanceLedger(t *testing.T) {
	setPlatformRoots(t)
	paths, err := PathsFor("synthetic", "sample-pp-cli", "sample")
	if err != nil {
		t.Fatal(err)
	}
	session := &Session{ProfileName: "synthetic", Source: "sample", CredentialFingerprint: "fingerprint", ObservedIdentity: map[string]string{"account_id": "one"}, GateOutcome: GateVerified, Paths: paths}
	budget := EndpointBudget{Class: "GET /profiles", Steady: 1, Interval: time.Second, Burst: 2, MaxAttempts: 3, RetryBudget: 10 * time.Second}
	first, err := NewEndpointLimiter(session, budget)
	if err != nil {
		t.Fatal(err)
	}
	second, err := NewEndpointLimiter(session, budget)
	if err != nil {
		t.Fatal(err)
	}
	now := time.Date(2026, time.July, 20, 0, 0, 0, 0, time.UTC)
	waits := []time.Duration{}
	first.now = func() time.Time { return now }
	second.now = func() time.Time { return now }
	first.sleep = func(_ context.Context, wait time.Duration) error { waits = append(waits, wait); return nil }
	second.sleep = func(_ context.Context, wait time.Duration) error { waits = append(waits, wait); return nil }
	if err := first.Wait(context.Background()); err != nil {
		t.Fatal(err)
	}
	if err := first.Wait(context.Background()); err != nil {
		t.Fatal(err)
	}
	if len(waits) != 0 {
		t.Fatalf("burst requests waited: %v", waits)
	}
	if err := first.Wait(context.Background()); err != nil {
		t.Fatal(err)
	}
	if err := second.Wait(context.Background()); err != nil {
		t.Fatal(err)
	}
	if len(waits) != 2 || waits[0] != time.Second || waits[1] != 2*time.Second {
		t.Fatalf("shared ledger waits = %v", waits)
	}
	if runtime.GOOS != "windows" {
		if info, err := os.Stat(first.path); err != nil || info.Mode().Perm() != 0o600 {
			t.Fatalf("limiter ledger mode = %v err=%v", info.Mode().Perm(), err)
		}
	}
}

func TestReceiptConformance(t *testing.T) {
	root := setPlatformRoots(t)
	paths, err := PathsFor("synthetic", "sample-pp-cli", "sample")
	if err != nil {
		t.Fatal(err)
	}
	session := &Session{Profile: &Profile{Name: "synthetic"}, ProfileName: "synthetic", CLI: "sample", Source: "sample", GateOutcome: GateVerified, ExpectedIdentity: map[string]string{"account_id": "one"}, ObservedIdentity: map[string]string{"account_id": "one"}, Paths: paths}
	receiptPath := filepath.Join(root, "receipt.json")
	auditDir := filepath.Join(root, "audit")
	writer, err := NewReceiptWriter(session, ReceiptOptions{CLI: ReceiptCLI{Name: "sample-pp-cli", Version: "test"}, Argv: []string{"sample-pp-cli", "--client-profile", "synthetic", "list"}, ReceiptFile: receiptPath, AuditDir: auditDir})
	if err != nil {
		t.Fatal(err)
	}
	var output bytes.Buffer
	captured := writer.CaptureWriter("stdout", &output)
	if _, err := captured.Write([]byte("aggregate-only\n")); err != nil {
		t.Fatal(err)
	}
	if err := writer.Finalize(context.Background(), "success", 0, map[string]RowCounts{"orders": {Read: 2, Emitted: 2}}, OutputMetadata{}, RateLimitMetadata{Requests: 1}); err != nil {
		t.Fatal(err)
	}
	data, err := os.ReadFile(receiptPath)
	if err != nil {
		t.Fatal(err)
	}
	if strings.Contains(string(data), "synthetic-credential") || strings.Contains(string(data), "aggregate-only") {
		t.Fatal("receipt persisted secret or output payload bytes")
	}
	var receipt Receipt
	if err := json.Unmarshal(data, &receipt); err != nil {
		t.Fatal(err)
	}
	if len(receipt.Outputs) != 1 || receipt.Outputs[0].Bytes != int64(len("aggregate-only\n")) || receipt.Outputs[0].SHA256 == "" {
		t.Fatalf("receipt outputs = %+v", receipt.Outputs)
	}
	if _, err := os.Stat(filepath.Join(auditDir, "index.jsonl")); err != nil {
		t.Fatal(err)
	}
}

type receiptStatusGolden struct {
	Name         string             `json:"name"`
	Status       string             `json:"status"`
	ExitCode     int                `json:"exit_code"`
	Gate         GateOutcome        `json:"gate"`
	Truncated    bool               `json:"truncated"`
	CapsHit      []TruncationReason `json:"caps_hit"`
	RateLimit    RateLimitMetadata  `json:"rate_limit"`
	OutputSHA256 string             `json:"output_sha256"`
	OutputBytes  int64              `json:"output_bytes"`
}

func TestReceiptStatusGoldenFixtures(t *testing.T) {
	goldenData, err := os.ReadFile("testdata/receipt-status-golden.json")
	if err != nil {
		t.Fatal(err)
	}
	var golden []receiptStatusGolden
	if err := json.Unmarshal(goldenData, &golden); err != nil {
		t.Fatal(err)
	}
	fixedStart := time.Date(2026, 7, 20, 0, 0, 0, 123000000, time.UTC)
	window := &ResolvedWindow{
		Requested: WindowRequest{Days: 1}, Start: fixedStart.Add(-24 * time.Hour), End: fixedStart,
		Timezone: "UTC", StartInclusive: true, EndExclusive: true,
	}
	for _, expected := range golden {
		t.Run(expected.Name, func(t *testing.T) {
			paths, err := PathsFor("synthetic", "sample-pp-cli", "sample")
			if err != nil {
				t.Fatal(err)
			}
			session := &Session{
				Profile: &Profile{Name: "synthetic"}, ProfileName: "synthetic", CLI: "sample", Source: "sample",
				GateOutcome: expected.Gate, ExpectedIdentity: map[string]string{"account_id": "one"}, ObservedIdentity: map[string]string{"account_id": "one"}, Paths: paths,
			}
			receiptPath := filepath.Join(t.TempDir(), expected.Name+".json")
			writer, err := NewReceiptWriter(session, ReceiptOptions{
				CLI:  ReceiptCLI{Name: "sample-pp-cli", Version: "test"},
				Argv: []string{"sample-pp-cli", "--legacy-token", "must-not-survive"}, ReceiptFile: receiptPath, Window: window,
			})
			if err != nil {
				t.Fatal(err)
			}
			writer.Receipt.RunID = "run-" + expected.Name
			writer.Receipt.StartedAt = fixedStart
			writer.now = func() time.Time { return fixedStart.Add(3 * time.Second) }
			writer.SetArgvRedactions([]int{2})
			if _, err := writer.CaptureWriter("stdout", io.Discard).Write([]byte("fixture output\n")); err != nil {
				t.Fatal(err)
			}
			metadata := OutputMetadata{ResolvedWindow: window, Truncated: expected.Truncated, TruncationReasons: expected.CapsHit}
			if err := writer.Finalize(context.Background(), expected.Status, expected.ExitCode, map[string]RowCounts{}, metadata, expected.RateLimit); err != nil {
				t.Fatal(err)
			}
			data, err := os.ReadFile(receiptPath)
			if err != nil {
				t.Fatal(err)
			}
			if strings.Contains(string(data), "must-not-survive") || strings.Contains(string(data), "fixture output") {
				t.Fatal("receipt retained a redacted argument or output payload")
			}
			var receipt Receipt
			if err := json.Unmarshal(data, &receipt); err != nil {
				t.Fatal(err)
			}
			if len(receipt.Outputs) != 1 || receipt.Window == nil || receipt.Window.Start != window.Start || receipt.Window.End != window.End || !receipt.StartedAt.Equal(fixedStart) || !receipt.FinishedAt.Equal(fixedStart.Add(3*time.Second)) || !reflect.DeepEqual(receipt.ArgvRedactions, []int{2}) {
				t.Fatalf("receipt schema fields = %+v", receipt)
			}
			actual := receiptStatusGolden{
				Name: expected.Name, Status: receipt.Status, ExitCode: receipt.ExitCode, Gate: receipt.Client.Gate,
				Truncated: receipt.Truncated, CapsHit: receipt.CapsHit, RateLimit: receipt.RateLimit,
				OutputSHA256: receipt.Outputs[0].SHA256, OutputBytes: receipt.Outputs[0].Bytes,
			}
			if actual.CapsHit == nil {
				actual.CapsHit = []TruncationReason{}
			}
			if !reflect.DeepEqual(actual, expected) {
				t.Fatalf("receipt golden mismatch\nactual:   %#v\nexpected: %#v", actual, expected)
			}
		})
	}
}
