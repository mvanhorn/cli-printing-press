func TestFileStoreRoundTrip(t *testing.T) {
	dir := t.TempDir()
	path := filepath.Join(dir, "tokens.json")
	s := NewFileStore(path)

	if _, err := s.Load(); !errors.Is(err, ErrNotFound) {
		t.Fatalf("expected ErrNotFound, got %v", err)
	}

	in := &Tokens{
		AccessToken:    "access-abc",
		RefreshToken:   "refresh-xyz",
		ExpiresAt:      time.Now().Add(time.Hour).UTC().Truncate(time.Second),
		ObtainedAt:     time.Now().UTC().Truncate(time.Second),
		Scope:          "user.info",
		ClientIDSuffix: "ABCD1234",
		RotationCount:  3,
	}
	if err := s.Save(in); err != nil {
		t.Fatalf("save: %v", err)
	}

	info, err := os.Stat(path)
	if err != nil {
		t.Fatalf("stat: %v", err)
	}
	if mode := info.Mode().Perm(); mode != 0o600 {
		t.Errorf("expected mode 0o600, got %o", mode)
	}

	out, err := s.Load()
	if err != nil {
		t.Fatalf("load: %v", err)
	}
	if out.AccessToken != in.AccessToken {
		t.Errorf("access token mismatch: %q vs %q", out.AccessToken, in.AccessToken)
	}
	if out.RefreshToken != in.RefreshToken {
		t.Errorf("refresh token mismatch")
	}
	if out.RotationCount != in.RotationCount {
		t.Errorf("rotation count mismatch")
	}
}

