func TestWriteDownloadUnderRejectsEscapeAndUsesPrivateMode(t *testing.T) {
	dir := filepath.Join(t.TempDir(), "downloads")
	hostile := []string{"../pwn", "..", "/tmp/pwn", "a/b", "a\\b"}
	for _, name := range hostile {
		if _, err := safeJoinUnder(dir, name); err == nil {
			t.Fatalf("safeJoinUnder accepted %q", name)
		}
		if err := writeDownloadUnder(dir, name, []byte("nope")); err == nil {
			t.Fatalf("writeDownloadUnder accepted %q", name)
		}
	}
	if err := writeDownloadUnder(dir, "clip-1.mp3", []byte("audio")); err != nil {
		t.Fatal(err)
	}
	if runtime.GOOS != "windows" {
		spaced := "report.txt "
		if err := writeDownloadUnder(dir, spaced, []byte("exact")); err != nil {
			t.Fatal(err)
		}
		if _, err := os.Stat(filepath.Join(dir, "report.txt")); !os.IsNotExist(err) {
			t.Fatalf("trimmed basename was written: %v", err)
		}
		spacedBody, err := os.ReadFile(filepath.Join(dir, spaced))
		if err != nil {
			t.Fatal(err)
		}
		if string(spacedBody) != "exact" {
			t.Fatalf("spaced body = %q", spacedBody)
		}
	}
	path := filepath.Join(dir, "clip-1.mp3")
	got, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	if string(got) != "audio" {
		t.Fatalf("body = %q", got)
	}
	if runtime.GOOS == "windows" {
		return
	}
	info, err := os.Stat(path)
	if err != nil {
		t.Fatal(err)
	}
	if info.Mode().Perm()&0o077 != 0 {
		t.Fatalf("file mode = %o", info.Mode().Perm())
	}
	dirInfo, err := os.Stat(dir)
	if err != nil {
		t.Fatal(err)
	}
	if dirInfo.Mode().Perm()&0o077 != 0 {
		t.Fatalf("dir mode = %o", dirInfo.Mode().Perm())
	}
}
