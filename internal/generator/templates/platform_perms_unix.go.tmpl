// Private-file permission checks (POSIX). Client profiles and the cache
// fingerprint key may carry or protect credentials, so neither may be group-
// or world-readable.
package platform

import (
	"fmt"
	"os"
)

// verifyPrivatePerms returns a non-nil error if the file at path is group- or
// world-accessible. info is the already-obtained Lstat result, so this adds no
// extra syscall. label names the artifact in the error text.
func verifyPrivatePerms(path string, info os.FileInfo, label string) error {
	if perm := info.Mode().Perm(); perm&0o077 != 0 {
		return fmt.Errorf("%s permissions must be 0600, got %04o; run: chmod 600 %s", label, perm, path)
	}
	return nil
}
