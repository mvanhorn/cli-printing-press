package testenv

import (
	"fmt"
	"testing"

	"golang.org/x/sys/windows"
)

// lockSandbox strips inherited ACEs from a t.TempDir() path under
// %LOCALAPPDATA%\Temp so credential tests can round-trip through the
// read-time DACL guard without granting non-owner principals access.
func lockSandbox(t *testing.T, path string) {
	t.Helper()
	tok, err := windows.OpenCurrentProcessToken()
	if err != nil {
		t.Fatalf("open process token: %v", err)
	}
	defer tok.Close()
	user, err := tok.GetTokenUser()
	if err != nil {
		t.Fatalf("get token user: %v", err)
	}
	sid := user.User.Sid.String()
	sddl := fmt.Sprintf("O:%sD:PAI(A;OICI;FA;;;%s)", sid, sid)
	sd, err := windows.SecurityDescriptorFromString(sddl)
	if err != nil {
		t.Fatalf("security descriptor from SDDL: %v", err)
	}
	dacl, _, err := sd.DACL()
	if err != nil {
		t.Fatalf("read DACL from SDDL: %v", err)
	}
	owner, _, err := sd.Owner()
	if err != nil {
		t.Fatalf("read owner from SDDL: %v", err)
	}
	err = windows.SetNamedSecurityInfo(
		path,
		windows.SE_FILE_OBJECT,
		windows.DACL_SECURITY_INFORMATION|windows.OWNER_SECURITY_INFORMATION|windows.PROTECTED_DACL_SECURITY_INFORMATION,
		owner,
		nil,
		dacl,
		nil,
	)
	if err != nil {
		t.Fatalf("lock sandbox DACL on %s: %v", path, err)
	}
}
