version: "2"

linters:
  enable:
    - errorlint
    - govet
    - ineffassign
    - staticcheck
    - unused
    - bodyclose
    - noctx
    - rowserrcheck
    - sqlclosecheck
  exclusions:
    # strict is the Go generated-file convention. These packages are
    # generator-owned even when a file has no marker yet.
    generated: strict
    paths:
      - internal/cliutil/
      - internal/platform/

formatters:
  enable:
    - gofmt
    - goimports
  exclusions:
    generated: strict
    paths:
      - internal/cliutil/
      - internal/platform/
