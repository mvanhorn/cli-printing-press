		t.Fatalf("curated prose should overlay the tree command, got %+v", commands["market breakouts"])
	}

	assertTop := func(query, want string) {
		t.Helper()
		got := rankWhich(index, query, 3)
		if len(got) == 0 || got[0].Entry.Command != want {
			t.Fatalf("query %q: want %s first, got %+v", query, want, got)
		}
