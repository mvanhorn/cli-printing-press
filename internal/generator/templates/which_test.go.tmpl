	assertTop("alpha beta", "alpha beta")
	assertTop("Alpha Beta", "alpha beta")
	assertTop("Hand-written alpha beta capability", "alpha beta")
	assertTop("handy", "alpha beta")
	assertTop("area child", "area child")
	assertTop("Child of a hidden area group", "area child")
	assertTop("market trend", "market trend")
	assertTop("Show the market trend", "market trend")
	assertTop("market breakouts", "market breakouts")
	assertTop("Find market breakouts before they fade", "market breakouts")
	assertTop("norun leaf", "norun leaf")
	assertTop("completion check", "completion check")

