		t.Fatalf("matches = %#v, want empty array", miss["matches"])
	}
}

func executeWhich(t *testing.T, root *cobra.Command, args ...string) ([]byte, error) {
	t.Helper()
	var stdout, stderr bytes.Buffer
	root.SetOut(&stdout)
	root.SetErr(&stderr)
	for _, cmd := range root.Commands() {
		cmd.SetOut(&stdout)
		cmd.SetErr(&stderr)
	}
	root.SetArgs(append([]string{"which"}, args...))
	err := root.Execute()
	if err != nil && stdout.Len() == 0 && stderr.Len() != 0 {
		t.Logf("stderr: %s", stderr.String())
	}
	return stdout.Bytes(), err
}

func TestWhichRuntime_EmptySurfaceExits2(t *testing.T) {
	old := whichIndex
	whichIndex = nil
	t.Cleanup(func() { whichIndex = old })

	cases := [][]string{
		{"alpha"},
		{},
	}
	for _, args := range cases {
		var stdout, stderr bytes.Buffer
		flags := &rootFlags{asJSON: true}
		cmd := newWhichCmd(flags)
		cmd.SetOut(&stdout)
		cmd.SetErr(&stderr)
		cmd.SetArgs(args)
		err := cmd.Execute()
		if err == nil {
			t.Fatalf("args %q: empty surface should fail, stdout=%q", args, stdout.String())
		}
		if got := ExitCode(err); got != 2 {
			t.Fatalf("args %q: ExitCode = %d, want 2", args, got)
		}
		if !strings.Contains(err.Error(), "no runnable commands") {
			t.Fatalf("args %q: err = %v, want the empty-surface error", args, err)
		}
		if stdout.Len() != 0 {
			t.Fatalf("args %q: empty surface should not write a match envelope, stdout=%q", args, stdout.String())
		}
	}
}
