		if _, ok := commands[entry.Command]; ok {
			t.Fatalf("duplicate command %q in runtime index", entry.Command)
		}
		commands[entry.Command] = entry
	}
	for _, want := range []string{"alpha beta", "area child", "completion check", "norun leaf", "market trend", "market breakouts"} {
		if _, ok := commands[want]; !ok {
			t.Fatalf("runtime index missing %q: %+v", want, index)
		}
	}
	for _, banned := range []string{"help", "completion", "area", "norun", "retired", "__complete"} {
		if _, ok := commands[banned]; ok {
			t.Fatalf("runtime index must exclude %q", banned)
		}
	}
