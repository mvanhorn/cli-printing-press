// TestResolveSDDLAlias calls ConvertStringSidToSid. A fake resolver would still
// pass if that round trip rejected LA. Any caller can resolve the alias.
func TestResolveSDDLAlias(t *testing.T) {
	sid, ok := resolveSDDLAlias("LA")
	if !ok {
		t.Fatal("resolveSDDLAlias(LA) rejected the built-in Administrator")
	}
	// RID 500 is the built-in Administrator on every machine. The account name
	// is locale-specific and may be renamed, so the SID is the stable check.
	if !regexp.MustCompile(`(?i)^S-1-5-21-\d+-\d+-\d+-500$`).MatchString(sid) {
		t.Fatalf("resolveSDDLAlias(LA) = %q, want S-1-5-21-...-500", sid)
	}
	parsed, err := windows.StringToSid(sid)
	if err != nil {
		t.Fatalf("StringToSid(%q): %v", sid, err)
	}
	account, _, accType, err := parsed.LookupAccount("")
	if err != nil {
		t.Fatalf("LookupAccount(%s): %v", sid, err)
	}
	if account == "" || accType != windows.SidTypeUser {
		t.Fatalf("LA account %q type %d, want a user account", account, accType)
	}
	if err := evalCredsSecurityResolved("O:LAD:PAI(A;;FA;;;LA)", sid, resolveSDDLAlias); err != nil {
		t.Fatalf("Administrator-owned file: %v", err)
	}
	if err := evalCredsSecurityResolved("O:LAD:PAI(A;;FA;;;LA)", "S-1-5-21-9-9-9-1000", resolveSDDLAlias); err == nil {
		t.Fatal("real LA resolver accepted a non-admin caller")
	}

	ba, ok := resolveSDDLAlias("BA")
	if !ok {
		t.Fatal("resolveSDDLAlias(BA) rejected BUILTIN\\Administrators")
	}
	if !strings.EqualFold(ba, sidBuiltinAdministrators) {
		t.Fatalf("resolveSDDLAlias(BA) = %q, want %s", ba, sidBuiltinAdministrators)
	}
	sy, ok := resolveSDDLAlias("SY")
	if !ok {
		t.Fatal("resolveSDDLAlias(SY) rejected LOCAL SYSTEM")
	}
	if !strings.EqualFold(sy, sidLocalSystem) {
		t.Fatalf("resolveSDDLAlias(SY) = %q, want %s", sy, sidLocalSystem)
	}

	if _, ok := resolveSDDLAlias("ZZ"); ok {
		t.Fatal("resolveSDDLAlias accepted unknown alias ZZ")
	}
}
