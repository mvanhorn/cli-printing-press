// sync_state is preferred when the allowlist includes it, but the spec
// validator does not require that table.
func chooseSnapshotSeedTable(tables []string) (string, error) {
	if len(tables) == 0 {
		return "", errors.New("no snapshot tables configured")
	}
	for _, table := range tables {
		if table == "sync_state" {
			return table, nil
		}
	}
	return tables[0], nil
}

type snapshotColumn struct {
	name       string
	typ        string
	notNull    bool
	primaryKey int
	hasDefault bool
}

func seedSnapshotRow(ctx context.Context, db *sql.DB, table string) (column string, marker any, err error) {
	exists, err := snapshotTableExists(ctx, db, table)
	if err != nil {
		return "", nil, fmt.Errorf("lookup snapshot table %s: %w", table, err)
	}
	if !exists {
		return "", nil, fmt.Errorf("snapshot table %q is not in the store", table)
	}
	cols, err := loadSnapshotColumns(ctx, db, table)
	if err != nil {
		return "", nil, err
	}
	if len(cols) == 0 {
		return "", nil, fmt.Errorf("snapshot table %q has no columns", table)
	}
	createSQL, err := snapshotCreateSQL(ctx, db, table)
	if err != nil {
		return "", nil, fmt.Errorf("read %s schema: %w", table, err)
	}
	checks := snapshotCheckLiterals(createSQL)

	var names []string
	var args []any
	for _, col := range cols {
		if col.primaryKey == 0 && (!col.notNull || col.hasDefault) {
			continue
		}
		val := snapshotSeedValue(col.typ, checks[strings.ToLower(col.name)])
		names = append(names, quoteIdent(col.name))
		args = append(args, val)
		if column == "" || col.primaryKey == 1 {
			column = col.name
			marker = val
		}
	}
	if len(names) == 0 {
		if _, err := db.ExecContext(ctx, "INSERT INTO "+quoteIdent(table)+" DEFAULT VALUES"); err != nil {
			return "", nil, fmt.Errorf("seed %s: %w", table, err)
		}
		return "", nil, nil
	}
	placeholders := strings.TrimRight(strings.Repeat("?,", len(args)), ",")
	query := "INSERT INTO " + quoteIdent(table) + " (" + strings.Join(names, ", ") + ") VALUES (" + placeholders + ")"
	if _, err := db.ExecContext(ctx, query, args...); err != nil {
		return "", nil, fmt.Errorf("seed %s: %w", table, err)
	}
	return column, marker, nil
}

func assertSeededSnapshotRow(ctx context.Context, db *sql.DB, table, column string, marker any) error {
	var count int
	var err error
	if column == "" {
		err = db.QueryRowContext(ctx, "SELECT COUNT(*) FROM "+quoteIdent(table)).Scan(&count)
	} else {
		query := "SELECT COUNT(*) FROM " + quoteIdent(table) + " WHERE " + quoteIdent(column) + " = ?"
		err = db.QueryRowContext(ctx, query, marker).Scan(&count)
	}
	if err != nil {
		return fmt.Errorf("count seeded %s row: %w", table, err)
	}
	if count != 1 {
		if column == "" {
			return fmt.Errorf("%s after import has %d rows, want 1", table, count)
		}
		return fmt.Errorf("%s.%s after import matched %d rows, want 1", table, column, count)
	}
	return nil
}

func snapshotTableExists(ctx context.Context, db *sql.DB, table string) (bool, error) {
	var n int
	if err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?`, table).Scan(&n); err != nil {
		return false, err
	}
	return n > 0, nil
}

func loadSnapshotColumns(ctx context.Context, db *sql.DB, table string) ([]snapshotColumn, error) {
	rows, err := db.QueryContext(ctx, `SELECT name, type, "notnull", dflt_value, pk FROM pragma_table_info(?) ORDER BY cid`, table)
	if err != nil {
		return nil, fmt.Errorf("read %s columns: %w", table, err)
	}
	defer rows.Close()
	var cols []snapshotColumn
	for rows.Next() {
		var col snapshotColumn
		var notNull, pk int
		var dflt any
		if err := rows.Scan(&col.name, &col.typ, &notNull, &dflt, &pk); err != nil {
			return nil, err
		}
		col.notNull = notNull != 0
		col.primaryKey = pk
		col.hasDefault = dflt != nil
		cols = append(cols, col)
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	return cols, nil
}

func snapshotCreateSQL(ctx context.Context, db *sql.DB, table string) (string, error) {
	var createSQL sql.NullString
	if err := db.QueryRowContext(ctx, `SELECT sql FROM sqlite_master WHERE type = 'table' AND name = ?`, table).Scan(&createSQL); err != nil {
		return "", err
	}
	return createSQL.String, nil
}

var (
	snapshotCheckInPattern    = regexp.MustCompile(`(?i)check\s*\(\s*(?:"([^"]+)"|([A-Za-z_][A-Za-z0-9_]*))\s+in\s*\(([^)]*)\)`)
	snapshotSQLLiteralPattern = regexp.MustCompile(`'([^']*)'|"([^"]*)"`)
)

func snapshotCheckLiterals(createSQL string) map[string][]string {
	found := make(map[string][]string)
	if strings.TrimSpace(createSQL) == "" {
		return found
	}
	for _, match := range snapshotCheckInPattern.FindAllStringSubmatch(createSQL, -1) {
		column := match[1]
		if column == "" {
			column = match[2]
		}
		list := match[3]
		var literals []string
		for _, lit := range snapshotSQLLiteralPattern.FindAllStringSubmatch(list, -1) {
			if strings.HasPrefix(lit[0], "'") {
				literals = append(literals, lit[1])
			} else {
				literals = append(literals, lit[2])
			}
		}
		if len(literals) == 0 {
			for _, part := range strings.Split(list, ",") {
				part = strings.TrimSpace(part)
				if part != "" {
					literals = append(literals, part)
				}
			}
		}
		if column != "" && len(literals) > 0 {
			found[strings.ToLower(column)] = literals
		}
	}
	return found
}

func snapshotSeedValue(typ string, literals []string) any {
	if len(literals) > 0 {
		return literals[0]
	}
	upper := strings.ToUpper(strings.TrimSpace(typ))
	switch {
	case strings.HasPrefix(upper, "INT"), strings.HasPrefix(upper, "BOOL"):
		return 1
	case strings.HasPrefix(upper, "REAL"), strings.HasPrefix(upper, "FLOA"), strings.HasPrefix(upper, "DOUB"), strings.HasPrefix(upper, "NUM"):
		return 1.0
	case strings.HasPrefix(upper, "JSON"):
		return "{}"
	default:
		return "seeded"
	}
}

