// TestShare_RejectsOptionLikeGitValues locks the git argument-injection
// hardening: a remote/branch/repo value that git would parse as an option
// (leading "-") is refused before any git invocation, so a crafted --remote
// or --branch cannot smuggle flags like --upload-pack= or --config= into the
// underlying git command.
func TestShare_RejectsOptionLikeGitValues(t *testing.T) {
	ctx := context.Background()
	repoDir := filepath.Join(t.TempDir(), "repo")
	cases := []struct {
		name string
		opts Options
	}{
		{"remote option injection", Options{RepoPath: repoDir, Remote: "--upload-pack=touch /tmp/pwned"}},
		{"branch option injection", Options{RepoPath: repoDir, Remote: "https://example.invalid/r.git", Branch: "--output=/tmp/x"}},
		{"repo path option injection", Options{RepoPath: "-repo", Remote: "https://example.invalid/r.git"}},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			if err := EnsureRepo(ctx, tc.opts); err == nil {
				t.Fatalf("EnsureRepo accepted option-like value: %+v", tc.opts)
			}
			if err := Pull(ctx, tc.opts); err == nil {
				t.Fatalf("Pull accepted option-like value: %+v", tc.opts)
			}
			if err := Push(ctx, tc.opts); err == nil {
				t.Fatalf("Push accepted option-like value: %+v", tc.opts)
			}
		})
	}
}

