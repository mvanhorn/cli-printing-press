	}
	payload, _ := io.ReadAll(resp.Body)
	return resp, payload
}

func assertMCPHTTPStreamSurvivesDeadline(t *testing.T, http2 bool, method string) {
	t.Helper()

	readTimeout := 200 * time.Millisecond
	var sawBody string
	handler := requireBearerAuthWithLimits("secret", nil, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if method == http.MethodPost {
			buf, err := io.ReadAll(r.Body)
			if err != nil {
				t.Errorf("handler read body: %v", err)
				return
			}
			sawBody = string(buf)
		}
		_, _ = io.WriteString(w, "a")
		if flusher, ok := w.(http.Flusher); ok {
			flusher.Flush()
		}
		time.Sleep(readTimeout + 150*time.Millisecond)
		_, _ = io.WriteString(w, "b")
	}), 1024, readTimeout)

	var srv *httptest.Server
	if http2 {
		srv = httptest.NewUnstartedServer(handler)
		srv.EnableHTTP2 = true
		srv.StartTLS()
	} else {
		srv = httptest.NewServer(handler)
	}
	t.Cleanup(srv.Close)

	var body io.Reader
	if method == http.MethodPost {
		body = strings.NewReader("ping")
	}
	req, err := http.NewRequest(method, srv.URL+"/mcp", body)
	if err != nil {
		t.Fatal(err)
	}
	req.Header.Set("Authorization", "Bearer secret")
	if method == http.MethodPost {
		req.Header.Set("Content-Type", "application/json")
	}
	client := srv.Client()
	client.Timeout = 3 * time.Second
	resp, err := client.Do(req)
	if err != nil {
		t.Fatalf("%s http2=%v: %v", method, http2, err)
	}
	defer resp.Body.Close()
	payload, err := io.ReadAll(resp.Body)
	if err != nil {
		t.Fatalf("read %s body: %v", method, err)
	}
	if resp.StatusCode != http.StatusOK {
		t.Fatalf("%s status = %d; body %s", method, resp.StatusCode, payload)
	}
	if string(payload) != "ab" {
		t.Fatalf("%s body = %q, want ab", method, payload)
	}
	if method == http.MethodPost && sawBody != "ping" {
		t.Fatalf("handler saw %q, want ping", sawBody)
	}
}

func mcpHTTPRawStatus(t *testing.T, srv *httptest.Server, request string) (int, error) {
	t.Helper()
	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
	if err != nil {
		return 0, err
	}
	defer conn.Close()
	_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
	if _, err := io.WriteString(conn, request); err != nil {
		return 0, err
	}
	br := bufio.NewReader(conn)
	line, err := br.ReadString('\n')
	if err != nil {
		return 0, err
	}
	var status int
	if _, err := fmt.Sscanf(line, "HTTP/1.1 %d", &status); err != nil {
		return 0, err
	}
	return status, nil
}
