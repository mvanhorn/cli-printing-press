	status, err := mcpHTTPRawStatus(t, srv, "POST /mcp HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: 1000000\r\n\r\n")
	if err != nil {
		t.Fatalf("read status: %v", err)
	}
	if time.Since(start) > 800*time.Millisecond {
		t.Fatalf("401 took %s; body read should not block the refusal", time.Since(start))
	}
	if status != http.StatusUnauthorized {
		t.Fatalf("status = %d, want 401", status)
	}
	if called.Load() {
		t.Fatal("handler ran before authentication")
	}
}

func TestMCPHTTPSmallPostReachesHandler(t *testing.T) {
	t.Parallel()

	var got []byte
	handler := requireBearerAuthWithLimits("secret", nil, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		got, _ = io.ReadAll(r.Body)
		w.WriteHeader(http.StatusNoContent)
	}), 128, 200*time.Millisecond)
	srv := httptest.NewServer(handler)
	t.Cleanup(srv.Close)

	req, err := http.NewRequest(http.MethodPost, srv.URL+"/mcp", strings.NewReader("ping"))
