func TestSpacefastRefusesPlaintextCredentials(t *testing.T) {
	refused := []string{"http://example.com", "http://10.0.0.5:8080", "http://[::ffff:8.8.8.8]"}
	for _, raw := range refused {
		u, _ := url.Parse(raw)
		if spacefastPlaintextCredentialError(u) == nil {
			t.Errorf("%s: credentials over plaintext http should be refused", raw)
		}
	}
	allowed := []string{"https://api.spacefast.com", "http://localhost:8080", "http://127.0.0.1:9000", "http://[::1]:9000", "http://LOCALHOST."}
	for _, raw := range allowed {
		u, _ := url.Parse(raw)
		if err := spacefastPlaintextCredentialError(u); err != nil {
			t.Errorf("%s: should be allowed, got %v", raw, err)
		}
	}
	if _, err := spacefastPublish("http://example.com", "secret-token", map[string]any{}, nil); err == nil || !strings.Contains(err.Error(), "plaintext") {
		t.Errorf("spacefastPublish to non-loopback http with a token = %v, want plaintext refusal", err)
	}
}
