func TestSpacefastTruncateKeepsUTF8(t *testing.T) {
	long := strings.Repeat("é", 400)
	got := spacefastTruncate(long, 300)
	if !utf8.ValidString(got) || utf8.RuneCountInString(got) != 301 {
		t.Errorf("truncation should keep 300 whole characters plus an ellipsis, got %d runes", utf8.RuneCountInString(got))
	}
	if spacefastTruncate("short", 300) != "short" {
		t.Error("short text should be unchanged")
	}
	plain := string(renderSpacefastPage("demo-page", []byte("NAME  PRICE\n<b>  1\n")))
	if !strings.Contains(plain, "<pre>") || !strings.Contains(plain, "&lt;b&gt;") {
		t.Error("non-JSON output should render escaped inside <pre>")
	}
}

