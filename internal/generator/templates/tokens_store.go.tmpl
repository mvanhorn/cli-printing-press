// Package tokens implements atomic OAuth2 refresh-token rotation persistence
// for {{humanName .Name}}. The headline bug it fixes: naive os.WriteFile
// persistence can fail mid-write or never persist at all, stranding the
// client in a state where the new refresh_token was sent to the server but
// the old one remains on disk. This package writes to a temp file, fsyncs
// the file, renames atomically, then fsyncs the parent directory — so a
// crash anywhere in that chain leaves either the OLD token (recoverable)
// or the NEW token (already saved). It can never leave a half-written file.
package tokens

import (
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"sync"
	"time"
)

// Tokens is the on-disk schema. Only the last 8 chars of the originating
// client_id are stored — never the secret. The integrity check guards
// against running a refreshed token against a different OAuth client
// (the dominant cause of silent reauth loops in multi-tenant CLI setups).
type Tokens struct {
	AccessToken    string    `json:"access_token"`
	RefreshToken   string    `json:"refresh_token"`
	ExpiresAt      time.Time `json:"expires_at"`
	ObtainedAt     time.Time `json:"obtained_at"`
	Scope          string    `json:"scope,omitempty"`
	ClientIDSuffix string    `json:"client_id_suffix,omitempty"`
	RotationCount  int       `json:"rotation_count,omitempty"`
	LastRotationAt time.Time `json:"last_rotation_at,omitempty"`
}

// ErrNotFound is returned by Load when the tokens file does not exist.
var ErrNotFound = errors.New("tokens file not found")

// Store is the interface implemented by both the file store and the
// keychain store. Keep the surface narrow so the OAuth login command
// can target either at the user's option.
type Store interface {
	Load() (*Tokens, error)
	Save(t *Tokens) error
	Clear() error
	Path() string
	Mode() string
}

// FileStore writes tokens to a JSON file at ~/.config/{{modulePath}}/tokens.json
// with 0600 permissions and an adjacent .lock file held during writes.
type FileStore struct {
	path string
	mu   sync.Mutex
}

// DefaultPath returns the canonical token file location, honoring
// {{envPrefix .Name}}_TOKENS_PATH for tests. Mode 0600 is enforced on every write.
func DefaultPath() string {
	if p := os.Getenv("{{envPrefix .Name}}_TOKENS_PATH"); p != "" {
		return p
	}
	home, _ := os.UserHomeDir()
	return filepath.Join(home, ".config", "{{modulePath}}", "tokens.json")
}

// NewFileStore constructs a FileStore. The file does not have to exist yet.
func NewFileStore(path string) *FileStore {
	if path == "" {
		path = DefaultPath()
	}
	return &FileStore{path: path}
}

// Path returns the resolved on-disk path.
func (s *FileStore) Path() string { return s.path }

// Mode returns the human-readable store mode for status reporting.
func (s *FileStore) Mode() string { return "file" }

// Load reads and parses the tokens file. Returns ErrNotFound when the
// file does not exist so callers can distinguish "no creds yet" from
// "corrupted creds".
func (s *FileStore) Load() (*Tokens, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	data, err := os.ReadFile(s.path)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, ErrNotFound
		}
		return nil, fmt.Errorf("reading tokens file: %w", err)
	}
	var t Tokens
	if err := json.Unmarshal(data, &t); err != nil {
		return nil, fmt.Errorf("parsing tokens file: %w", err)
	}
	return &t, nil
}

// Save atomically persists tokens. The critical path:
//  1. mkdir -p parent dir (0o700)
//  2. write to tmp file (0o600) with unique suffix to avoid lock collisions
//  3. fsync the tmp file
//  4. rename tmp -> final (atomic on POSIX)
//  5. fsync the parent dir so the rename hits the disk
//
// THIS IS THE HEADLINE BUG FIX. A failure between steps 2 and 4 leaves the
// previous tokens.json intact; a failure at step 5 risks losing the new
// rename on power loss but never strands a half-written file.
func (s *FileStore) Save(t *Tokens) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	dir := filepath.Dir(s.path)
	if err := os.MkdirAll(dir, 0o700); err != nil {
		return fmt.Errorf("creating tokens dir: %w", err)
	}

	data, err := json.MarshalIndent(t, "", "  ")
	if err != nil {
		return fmt.Errorf("marshaling tokens: %w", err)
	}

	tmp := fmt.Sprintf("%s.tmp.%d.%d", s.path, os.Getpid(), time.Now().UnixNano())
	f, err := os.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o600)
	if err != nil {
		return fmt.Errorf("opening tmp tokens file: %w", err)
	}
	if _, werr := f.Write(data); werr != nil {
		f.Close()
		os.Remove(tmp)
		return fmt.Errorf("writing tmp tokens: %w", werr)
	}
	if syncErr := f.Sync(); syncErr != nil {
		f.Close()
		os.Remove(tmp)
		return fmt.Errorf("fsync tmp tokens: %w", syncErr)
	}
	if closeErr := f.Close(); closeErr != nil {
		os.Remove(tmp)
		return fmt.Errorf("closing tmp tokens: %w", closeErr)
	}
	if renameErr := os.Rename(tmp, s.path); renameErr != nil {
		os.Remove(tmp)
		return fmt.Errorf("rename tmp tokens: %w", renameErr)
	}
	// fsync the parent directory so the rename is durable. On macOS / Linux,
	// O_RDONLY is sufficient. If this fails we still keep the file content;
	// surface the error so the caller can decide whether to abort.
	if dirFile, derr := os.Open(dir); derr == nil {
		_ = dirFile.Sync()
		dirFile.Close()
	}
	return nil
}

// Clear removes the tokens file. Returns nil when the file is already gone.
func (s *FileStore) Clear() error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if err := os.Remove(s.path); err != nil && !os.IsNotExist(err) {
		return fmt.Errorf("removing tokens file: %w", err)
	}
	return nil
}

// ClientIDSuffix returns the last 8 chars of a client_id for the integrity
// check. Returns the whole id if it's shorter than 8 chars (test fixtures).
func ClientIDSuffix(clientID string) string {
	if len(clientID) <= 8 {
		return clientID
	}
	return clientID[len(clientID)-8:]
}
