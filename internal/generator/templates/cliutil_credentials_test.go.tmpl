func TestExplicitProfileSaveRollsBackWhenConfigWriteFails(t *testing.T) {
	home, globalPath, globalBefore := seedGlobalSession(t, "session-a")

	t.Run("removesCreatedFile", func(t *testing.T) {
		profile, configPath := writeProfileConfig(t, home, "rollback-new")
		cfg, err := config.Load(configPath)
		if err != nil {
			t.Fatal(err)
		}
		replacePathWithDirectory(t, configPath)
		if err := saveConfigCredential(cfg, "session-b"); err == nil {
			t.Fatal("expected config write failure")
		}
		credsPath := filepath.Join(profile, "data", "credentials.toml")
		if _, err := os.Stat(credsPath); !os.IsNotExist(err) {
			data, _ := os.ReadFile(credsPath)
			t.Fatalf("profile credentials remained after rollback, err=%v data=%q", err, data)
		}
		assertGlobalUnchanged(t, globalPath, globalBefore)
	})

	t.Run("restoresPriorBytes", func(t *testing.T) {
		profile, configPath := writeProfileConfig(t, home, "rollback-old")
		credsPath := filepath.Join(profile, "data", "credentials.toml")
		prior := []byte("access_token = \"old-secret\"\n")
		if err := os.MkdirAll(filepath.Dir(credsPath), 0o700); err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(credsPath, prior, 0o600); err != nil {
			t.Fatal(err)
		}
		cfg, err := config.Load(configPath)
		if err != nil {
			t.Fatal(err)
		}
		replacePathWithDirectory(t, configPath)
		if err := saveConfigCredential(cfg, "session-b"); err == nil {
			t.Fatal("expected config write failure")
		}
		got, err := os.ReadFile(credsPath)
		if err != nil {
			t.Fatal(err)
		}
		if !bytes.Equal(got, prior) {
			t.Fatalf("profile credentials = %q, want %q", got, prior)
		}
		assertGlobalUnchanged(t, globalPath, globalBefore)
	})
}

func seedGlobalSession(t *testing.T, token string) (home, globalPath string, globalBefore []byte) {
