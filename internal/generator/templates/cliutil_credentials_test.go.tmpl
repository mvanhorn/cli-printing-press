	if err := os.WriteFile(foreignFile, foreignBody, 0o600); err != nil {
		t.Fatal(err)
	}
	before := dirNames(t, foreign)
	if err := os.Symlink(foreign, filepath.Join(profile, "data")); err != nil {
		t.Fatal(err)
	}
	cfg, err := config.Load(configPath)
	if err != nil {
		t.Fatal(err)
	}
	if err := saveConfigCredential(cfg, "session-b"); err == nil {
		t.Fatal("expected profile save to refuse a symlinked data directory")
	}
	got, err := os.ReadFile(foreignFile)
	if err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(got, foreignBody) {
		t.Fatalf("foreign credentials = %q, want %q", got, foreignBody)
	}
	assertDirUnchanged(t, foreign, before)
	assertGlobalUnchanged(t, globalPath, globalBefore)
	if err := cfg.ClearTokens(); err == nil {
		t.Fatal("expected profile logout to refuse a symlinked data directory")
	}
	got, err = os.ReadFile(foreignFile)
	if err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(got, foreignBody) {
		t.Fatalf("logout changed foreign credentials to %q", got)
	}
	assertDirUnchanged(t, foreign, before)
}

