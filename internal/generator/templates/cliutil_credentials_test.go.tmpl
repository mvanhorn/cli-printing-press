func TestExplicitProfileLoginKeepsGlobalCredentials(t *testing.T) {
	home, _ := resetCredentialEnv(t)
	dataDir := filepath.Join(home, "global-data")
	t.Setenv("{{envName .Name}}_DATA_DIR", dataDir)
	globalCfg, err := config.Load("")
	if err != nil {
		t.Fatalf("Load() error = %v", err)
	}
	writeConfigCredential(t, globalCfg, "session-a")
	globalPath, globalBefore := globalCredentialsBytes(t)

	profile, configPath := writeProfileConfig(t, home, "lab")
	decoy := t.TempDir()
	t.Setenv("XDG_CONFIG_HOME", filepath.Join(decoy, ".config"))
	t.Setenv("XDG_DATA_HOME", filepath.Join(decoy, ".local", "share"))
	t.Setenv("{{envName .Name}}_HOME", decoy)
	t.Setenv("{{envName .Name}}_CONFIG_DIR", filepath.Join(decoy, "config"))

	profileCfg, err := config.Load(configPath)
	if err != nil {
		t.Fatalf("Load(profile) error = %v", err)
	}
	writeConfigCredential(t, profileCfg, "session-b")

	profileCreds := filepath.Join(profile, "data", "credentials.toml")
	body, err := os.ReadFile(profileCreds)
	if err != nil {
		t.Fatalf("read profile credentials: %v", err)
	}
	if !strings.Contains(string(body), "session-b") {
		t.Fatalf("profile credentials = %q, want session-b", body)
	}
	info, err := os.Lstat(profileCreds)
	if err != nil {
		t.Fatal(err)
	}
	if info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() {
		t.Fatalf("profile credentials mode = %v, want a regular file", info.Mode())
	}
	if runtime.GOOS != "windows" && info.Mode().Perm() != 0o600 {
		t.Fatalf("profile credentials mode = %o, want 0600", info.Mode().Perm())
	}
	assertGlobalUnchanged(t, globalPath, globalBefore)
	if treeContains(t, decoy, "session-b") {
		t.Fatal("profile login wrote the secret into the overridden home")
	}

	reloaded, err := config.Load(configPath)
	if err != nil {
		t.Fatalf("reload profile: %v", err)
	}
	assertConfigCredential(t, reloaded, "session-b")
	def, err := config.Load("")
	if err != nil {
		t.Fatalf("reload default: %v", err)
	}
	assertConfigCredential(t, def, "session-a")

	if err := reloaded.ClearTokens(); err != nil {
		t.Fatalf("ClearTokens(profile) error = %v", err)
	}
	if _, err := os.Stat(profileCreds); !os.IsNotExist(err) {
		t.Fatalf("profile credentials remained after logout, stat err = %v", err)
	}
	assertGlobalUnchanged(t, globalPath, globalBefore)
	afterLogout, err := config.Load(configPath)
	if err != nil {
		t.Fatalf("reload profile after logout: %v", err)
	}
	assertConfigCredential(t, afterLogout, "")
	defAfter, err := config.Load("")
	if err != nil {
		t.Fatalf("reload default after profile logout: %v", err)
	}
	assertConfigCredential(t, defAfter, "session-a")
}

