func basicAuthHeaderForCredential(token string) string {
	payload := strings.TrimSpace({{printf "%q" .Auth.Format}})
	if scheme, rest, ok := strings.Cut(payload, " "); ok && strings.EqualFold(strings.TrimSpace(scheme), "Basic") {
		payload = strings.TrimSpace(rest)
	}
	replacements := map[string]string{
{{- $basicAuthEnvVarCount := len $basicCredentialVars}}
{{- $firstBasicAuthPlaceholder := ""}}
{{- if gt $basicAuthEnvVarCount 0}}
{{- $firstBasicAuthPlaceholder = envVarPlaceholder (index $basicCredentialVars 0).Name}}
{{- end}}
{{- range $i, $env := $basicCredentialVars}}
{{- $placeholder := envVarPlaceholder .Name}}
		{{printf "%q" $placeholder}}: token{{if gt $i 0}} + "-secondary"{{end}},
		{{printf "%q" .Name}}: token{{if gt $i 0}} + "-secondary"{{end}},
{{- if eq $i 0}}
{{- if ne $placeholder "username"}}
		"username": token,
{{- end}}
{{- if ne $placeholder "user"}}
		"user": token,
{{- end}}
{{- else if eq $i 1}}
{{- if ne $placeholder "password"}}
		"password": token + "-secondary",
{{- end}}
{{- if ne $placeholder "secret"}}
		"secret": token + "-secondary",
{{- end}}
{{- if and (ne $placeholder "token") (ne $firstBasicAuthPlaceholder "token")}}
		"token": token + "-secondary",
{{- end}}
{{- if and (ne $placeholder "access_token") (ne $firstBasicAuthPlaceholder "access_token")}}
		"access_token": token + "-secondary",
{{- end}}
{{- end}}
{{- end}}
	}
	for key, value := range replacements {
		payload = strings.ReplaceAll(payload, "{"+key+"}", value)
	}
	return "Basic " + base64.StdEncoding.EncodeToString([]byte(payload))
}

func assertAuthHeaderCredential(t *testing.T, cfg *config.Config, wantToken, rejectToken string) {
	t.Helper()
	got := cfg.AuthHeader()
	want := basicAuthHeaderForCredential(wantToken)
	if got != want {
		t.Fatalf("AuthHeader() = %q, want header derived from %q", got, wantToken)
	}
	if rejectToken != "" && got == basicAuthHeaderForCredential(rejectToken) {
		t.Fatalf("AuthHeader() used rejected credential %q", rejectToken)
	}
}

