	session.SetResolvedWindow(window)
	flags := &rootFlags{asJSON: true, platformSession: session}
	var output bytes.Buffer
	rows := make([]map[string]any, 0, 1)
	rows = append(rows, map[string]any{"orders": 2})
	if err := printJSONFiltered(&output, rows, flags); err != nil {
		t.Fatal(err)
	}
	var envelope struct {
		Data []map[string]any        `json:"data"`
		Meta platform.OutputMetadata `json:"meta"`
	}
	if err := json.Unmarshal(output.Bytes(), &envelope); err != nil {
		t.Fatalf("structured output is not the platform envelope: %v: %s", err, output.String())
	}
	if envelope.Meta.Truncated || envelope.Meta.ResolvedWindow == nil || len(envelope.Data) != 1 {
		t.Fatalf("platform output metadata = %+v data=%+v", envelope.Meta, envelope.Data)
	}

	agentFlags := &rootFlags{asJSON: true, agent: true, platformSession: session}
	output.Reset()
	if err := printJSONFiltered(&output, rows, agentFlags); err != nil {
		t.Fatal(err)
	}
	var agentEnvelope struct {
		Results []map[string]any `json:"results"`
		Meta struct {
			Source         string                   `json:"source"`
			Truncated      bool                     `json:"truncated"`
			ResolvedWindow *platform.ResolvedWindow `json:"resolved_window"`
		} `json:"meta"`
	}
	if err := json.Unmarshal(output.Bytes(), &agentEnvelope); err != nil {
		t.Fatalf("agent output is not the platform envelope: %v: %s", err, output.String())
	}
	if agentEnvelope.Meta.Source != "local" || agentEnvelope.Meta.Truncated || agentEnvelope.Meta.ResolvedWindow == nil || len(agentEnvelope.Results) != 1 {
		t.Fatalf("agent platform output metadata = %+v results=%+v", agentEnvelope.Meta, agentEnvelope.Results)
	}

	// A native API response can legitimately use meta plus data/results and
	// fields that collide with the platform contract. Raw responses must be
	// wrapped, not mistaken for an envelope created by this CLI.
	native := json.RawMessage(`{"meta":{"truncated":true,"resolved_window":"upstream-window","warnings":["upstream"]},"data":{"id":"native"}}`)
	nativeWrapped, err := wrapPlatformStructuredOutput(native, flags, "data", false)
	if err != nil {
		t.Fatal(err)
	}
	var nativeEnvelope struct {
		Meta platform.OutputMetadata `json:"meta"`
		Data struct {
			Meta struct {
				Truncated      bool     `json:"truncated"`
				ResolvedWindow string   `json:"resolved_window"`
				Warnings       []string `json:"warnings"`
			} `json:"meta"`
			Data map[string]string `json:"data"`
		} `json:"data"`
	}
	if err := json.Unmarshal(nativeWrapped, &nativeEnvelope); err != nil {
		t.Fatalf("native response wrapper is invalid: %v: %s", err, nativeWrapped)
	}
	if nativeEnvelope.Meta.Truncated || !nativeEnvelope.Data.Meta.Truncated || nativeEnvelope.Data.Meta.ResolvedWindow != "upstream-window" || len(nativeEnvelope.Data.Meta.Warnings) != 1 || nativeEnvelope.Data.Data["id"] != "native" {
		t.Fatalf("native metadata was not preserved: %+v", nativeEnvelope)
	}

	zero := 0.0
	declaration := platform.AnalyticsDeclaration{
		ClientProfile:    "tenant-a",
		TenantIdentity:   map[string]string{"account_id": "acct-a"},
		DataSource:       "fixture",
		RequiredInputs:   []string{"orders"},
		JoinKeys:         []string{},
		InputRows:        map[string]int64{"orders": 2},
		ValidJoinKeys:    map[string]int64{},
		MissingJoinKeys:  map[string]int64{},
		MatchedRows:      2,
		NewestRowAt:      map[string]time.Time{},
		FreshnessStatus:  map[string]string{"orders": "unknown"},
		BusinessMetrics:  map[string]*float64{"net_sales": &zero},
		MinimumInputRows: map[string]int64{"orders": 1},
		Remediation:      "verify fixture order input and net sales calculation",
	}
	formatFlags := make([]*rootFlags, 0, 4)
	formatFlags = append(formatFlags,
		&rootFlags{asJSON: true, platformSession: session},
		&rootFlags{csv: true, platformSession: session},
		&rootFlags{plain: true, platformSession: session},
		&rootFlags{asJSON: true, agent: true, platformSession: session},
	)
	for _, formatFlags := range formatFlags {
		declarePlatformAnalytics(formatFlags, declaration)
		output.Reset()
		if err := printJSONFiltered(&output, map[string]any{"net_sales": 0}, formatFlags); err == nil || !strings.Contains(err.Error(), "all_business_metrics_zero_or_null") {
			t.Fatalf("all-zero analytics output was not rejected for flags %+v: %v", formatFlags, err)
		}
	}

	csvFlags := &rootFlags{csv: true, platformSession: session}
	var event bytes.Buffer
	csvFlags.platformMetadataWriter = &event
	output.Reset()
	if err := printJSONFiltered(&output, rows, csvFlags); err != nil {
		t.Fatal(err)
	}
	var finalErr error
	finalizePlatformInvocation(csvFlags, &finalErr)
	if finalErr != nil {
		t.Fatal(finalErr)
	}
	if got := output.String(); !strings.Contains(got, "orders") || !strings.Contains(got, "2") {
		t.Fatalf("CSV output = %s", got)
	}
	if got := event.String(); !strings.Contains(got, `"event":"output_metadata"`) || !strings.Contains(got, `"truncated":false`) {
		t.Fatalf("CSV output metadata event = %s", got)
	}
}

func TestRunProfilesRejectCredentialLikeFields(t *testing.T) {
	for _, name := range []string{"api-token", "client_secret", "password", "authorization", "session-cookie"} {
		if !credentialLikeRunProfileFlag(name) {
			t.Fatalf("credential-like run-profile flag %q was accepted", name)
		}
	}
	for _, name := range []string{"region", "limit", "start-date", "compact"} {
		if credentialLikeRunProfileFlag(name) {
			t.Fatalf("safe run-profile flag %q was rejected", name)
		}
	}
}

