// CredentialSyntaxes returns the human-readable reference forms, for errors.
func CredentialSyntaxes() []string {
	syntaxes := []string{}
	for _, scheme := range CredentialSchemes() {
		syntaxes = append(syntaxes, scheme.Syntax)
	}
	return syntaxes
}

func lookupCredentialResolver(ref string) (registeredCredentialResolver, bool) {
	credentialRegistryMu.RLock()
	defer credentialRegistryMu.RUnlock()
