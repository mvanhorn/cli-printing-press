func TestWithFileLock_SerializesCallers(t *testing.T) {
	t.Parallel()
	path := filepath.Join(t.TempDir(), "teach.log")
	var (
		value int
		wg    sync.WaitGroup
	)
	const n = 20
	wg.Add(n)
	for i := 0; i < n; i++ {
		go func() {
			defer wg.Done()
			err := WithFileLock(path, func() error {
				cur := value
				time.Sleep(time.Millisecond)
				value = cur + 1
				return nil
			})
			if err != nil {
				t.Errorf("WithFileLock: %v", err)
			}
		}()
	}
	wg.Wait()
	if value != n {
		t.Fatalf("lost updates under lock: got %d want %d", value, n)
	}
}
