func streamObjectID(data json.RawMessage, keys ...string) string {
	if obj, err := DecodeJSONObject(data); err == nil {
		for _, key := range keys {
			if key == "" {
				continue
			}
			if v := LookupFieldValue(obj, key); v != nil {
				if s := CanonicalResourceID(v); s != "" {
					return s
				}
			}
		}
	}
	return fmt.Sprintf("%x", ftsRowID("stream", string(data)))
}

