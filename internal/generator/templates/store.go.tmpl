			INSERT INTO {{safeNameSuffix .Name "_fts"}}({{safeNameSuffix .Name "_fts"}}, rowid, {{safeJoin .FTS5Fields ", "}})
			VALUES ('delete', old.rowid, {{- range $i, $field := .FTS5Fields}}{{if $i}}, {{end}}old.{{safeName $field}}{{- end}});
