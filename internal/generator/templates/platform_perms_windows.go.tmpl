// Private-file permission checks (Windows).
//
// Windows has no POSIX mode bits. os.Chmod only toggles the read-only
// attribute, so a file written 0600 stats back as 0666 and a POSIX mode-bit
// comparison can never be satisfied. Comparing mode bits here would reject
// every profile and every cache key on every Windows host.
//
// The equivalent signal is the security descriptor, and internal/cliutil
// already evaluates it (owner + DACL against the current-user SID). We reuse
// that evaluator rather than growing a second one that could drift.
//
// It is ADVISORY here, deliberately. Nothing in this CLI ever sets a
// restrictive DACL: both writePrivateFile (this package) and
// cliutil.AtomicWritePrivateFile only call Chmod, which is a no-op on NTFS. A
// private file therefore inherits whatever ACL its parent directory carries.
// Under %USERPROFILE% that is typically owner + SYSTEM + Administrators and
// passes; under %TEMP%, or any directory carrying stale ACEs from a previous
// domain identity, it does not. Hard-failing the read would block the user for
// an ACL the tool never promised to set.
//
// The path to enforcement is writer-first: have writePrivateFile set an
// explicit DACL on Windows, then turn this warning into an error. Until then,
// surfacing the finding is honest and blocking on it is not.
package platform

import (
	"fmt"
	"os"

	"{{modulePath}}/internal/cliutil"
)

// verifyPrivatePerms reports an unsafe owner or DACL on stderr and allows the
// read to proceed. info is unused: mode bits carry no access-control meaning on
// NTFS. label names the artifact in the warning.
func verifyPrivatePerms(path string, _ os.FileInfo, label string) error {
	if err := cliutil.VerifyCredsPerms(path); err != nil {
		fmt.Fprintf(os.Stderr,
			"warning: %s %s has permissive access (%v); on Windows this is advisory\n",
			label, path, err)
	}
	return nil
}
