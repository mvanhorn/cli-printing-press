// Private-file permission checks (Windows).
//
// Windows mode bits do not model access control. Reuse cliutil's owner and DACL
// check, but report it as advisory because generated writers do not establish
// an explicit Windows DACL.
package platform

import (
	"fmt"
	"os"

	"{{modulePath}}/internal/cliutil"
)

// verifyPrivatePerms reports an unsafe owner or DACL on stderr and allows the
// read to proceed. info is unused: mode bits carry no access-control meaning on
// NTFS. label names the artifact in the warning.
func verifyPrivatePerms(path string, _ os.FileInfo, label string) error {
	if err := cliutil.VerifyCredsPerms(path); err != nil {
		fmt.Fprintf(os.Stderr,
			"warning: %s %s has permissive access (%v); on Windows this is advisory\n",
			label, path, err)
	}
	return nil
}
