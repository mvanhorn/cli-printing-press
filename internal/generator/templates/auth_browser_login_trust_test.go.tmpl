// trustLoginProbeCert makes clients cloned from http.DefaultTransport trust
// srv. Login validation builds that client itself, so the certificate has to
// be on the shared transport before the probe. The pool is only the test
// certificate; cleanup puts the previous config back.
func trustLoginProbeCert(t *testing.T, srv *httptest.Server) {
	t.Helper()
	cert := srv.Certificate()
	if cert == nil {
		t.Fatal("login probe server has no certificate")
	}
	pool := x509.NewCertPool()
	pool.AddCert(cert)
	base, ok := http.DefaultTransport.(*http.Transport)
	if !ok || base == nil {
		t.Fatal("DefaultTransport is not *http.Transport")
	}
	prev := base.TLSClientConfig
	next := &tls.Config{RootCAs: pool}
	if prev != nil {
		next = prev.Clone()
		next.RootCAs = pool
	}
	base.TLSClientConfig = next
	t.Cleanup(func() {
		base.TLSClientConfig = prev
		base.CloseIdleConnections()
	})
}

