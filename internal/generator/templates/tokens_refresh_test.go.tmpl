// TestLoadRefreshConfig_ConfigFileFallback verifies that when env vars are
// absent, LoadRefreshConfig reads client_id/client_secret from config.toml.
// Regression guard for the bug where an env-only loader breaks the
// config.toml path for cron and non-Claude shells.
func TestLoadRefreshConfig_ConfigFileFallback(t *testing.T) {
	dir := t.TempDir()
	configPath := filepath.Join(dir, "config.toml")
	contents := []byte(`base_url = "https://example.invalid"
client_id = "id-from-config-toml"
client_secret = "secret-from-config-toml"
`)
	if err := os.WriteFile(configPath, contents, 0o600); err != nil {
		t.Fatalf("write config: %v", err)
	}

	t.Setenv("{{envPrefix .Name}}_CONFIG", configPath)
	t.Setenv("{{envPrefix .Name}}_CLIENT_ID", "")
	t.Setenv("{{envPrefix .Name}}_CLIENT_SECRET", "")
	t.Setenv("{{envPrefix .Name}}_TOKEN_URL", "")

	cfg := LoadRefreshConfig()

	if cfg.ClientID != "id-from-config-toml" {
		t.Errorf("ClientID: got %q, want %q (refresh code path must fall back to config.toml when env is empty)", cfg.ClientID, "id-from-config-toml")
	}
	if cfg.ClientSecret != "secret-from-config-toml" {
		t.Errorf("ClientSecret: got %q, want %q", cfg.ClientSecret, "secret-from-config-toml")
	}
	if cfg.TokenURL != DefaultTokenURL {
		t.Errorf("TokenURL: got %q, want default %q", cfg.TokenURL, DefaultTokenURL)
	}
}

