// TestAcquireRefreshLock_BasicRoundTrip verifies the interprocess flock
// helper acquires + releases without error and creates the .lock sidecar
// at the expected path with mode 0600.
func TestAcquireRefreshLock_BasicRoundTrip(t *testing.T) {
	dir := t.TempDir()
	storePath := filepath.Join(dir, "tokens.json")

	unlock, err := acquireRefreshLock(storePath)
	if err != nil {
		t.Fatalf("acquire: %v", err)
	}

	lockPath := storePath + ".lock"
	info, err := os.Stat(lockPath)
	if err != nil {
		t.Fatalf("stat lock file: %v", err)
	}
	if mode := info.Mode().Perm(); mode != 0o600 {
		t.Errorf("lock file mode: got %o, want 0o600", mode)
	}

	unlock()

	// Re-acquiring after release should succeed.
	unlock2, err := acquireRefreshLock(storePath)
	if err != nil {
		t.Fatalf("re-acquire: %v", err)
	}
	unlock2()
}

